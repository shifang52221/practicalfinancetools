---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewedByCard from "../components/ReviewedByCard.astro";
import TrustPolicyLinks from "../components/TrustPolicyLinks.astro";
import { SITE } from "../config/site";
import { TRUST_PROFILES } from "../config/trust";

const title = `Privacy Policy | ${SITE.name}`;
const description = "Privacy policy describing how this site handles calculator inputs, consent choices, cookies, analytics, and advertising.";

const lastUpdated = "2026-04-06";
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/privacy-policy"
  lastUpdated={lastUpdated}
  authorProfile={TRUST_PROFILES.siteOwner}
  reviewProfiles={[TRUST_PROFILES.editorialReview, TRUST_PROFILES.methodologyReview]}
>
  <section class="card hero">
    <h1>Privacy Policy</h1>
    <p>
      This policy explains what limited data this site may receive, how consent choices affect analytics and
      advertising, and how to contact us about privacy requests.
    </p>
    <p class="muted">Last updated: 2026-04-06</p>
  </section>

  <ReviewedByCard
    writtenBy={TRUST_PROFILES.siteOwner}
    reviewedBy={TRUST_PROFILES.editorialReview}
    secondaryReview={TRUST_PROFILES.methodologyReview}
    reviewScope="Public privacy disclosures, consent handling, analytics and advertising transparency, and correction-routing language."
    reviewedOn="2026-04-06"
  />

  <TrustPolicyLinks currentPath="/privacy-policy" intro="Use these public policy pages to understand who maintains the site, how privacy and methodology decisions are documented, and where to send corrections or privacy requests." />

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Summary</h2>
    <p class="muted" style="margin:10px 0 0">
      Practical Finance Tools does not require account creation. Most calculator inputs are intended to run in your
      browser so you can compare scenarios without submitting a profile or storing a financial account on the site.
      We still use a small amount of operational data for hosting, debugging, security, measurement, and advertising.
    </p>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">What information we may receive</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li>Basic technical request data such as IP address, user agent, approximate location, and timestamps in server logs.</li>
        <li>Cookie or device identifiers used for consent status, measurement, and ad delivery if optional services are enabled.</li>
        <li>Your email address and message if you contact us directly.</li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">What we do not ask for</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li>No user account, password, or dashboard profile is required.</li>
        <li>No bank-login connection or credit-report pull is used by the calculators.</li>
        <li>No reason to submit sensitive personal or financial identifiers in contact messages.</li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Calculator inputs and local storage</h2>
    <p class="muted" style="margin:10px 0 0">
      Calculator inputs are designed to be processed locally in your browser. The site may use local storage for limited
      operational behavior such as remembering a consent choice, but calculator scenarios are not intended to create a
      server-side user account or long-term financial profile. If you share a device, clear your browser history, cookies,
      and local storage when you are done.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Cookies, consent, analytics, and advertising</h2>
    <p class="muted" style="margin:10px 0 0">
      The site uses a consent banner so visitors can accept or decline optional advertising behavior. We may use Google Analytics
      to understand traffic patterns and page performance, and we may display ads from third-party providers
      such as Google AdSense. Those services may use cookies or similar technologies depending on your consent choice,
      browser settings, and region.
    </p>
    <ul class="muted" style="margin:12px 0 0; padding-left:18px">
      <li>Essential site functions can run without personalized advertising.</li>
      <li>The consent banner and <a href="/cookie-notice">Cookie Notice</a> explain how to update your preference.</li>
      <li>If optional services are declined, we aim to reduce or disable non-essential ad-personalization behavior where supported.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Global Privacy Control and ad choices</h2>
    <p class="muted" style="margin:10px 0 0">
      If your browser sends a Global Privacy Control signal, we interpret that as an opt-out signal for certain advertising
      uses where applicable. You can also manage ad personalization directly through{" "}
      <a href="https://adssettings.google.com/" rel="noopener noreferrer" target="_blank">Google Ad Settings</a>.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">How long information may be kept</h2>
    <p class="muted" style="margin:10px 0 0">
      Server and operational logs may be retained for a limited period for security, debugging, abuse prevention, and
      performance analysis. Contact messages may be kept long enough to answer the message, keep an operations trail,
      and document corrections or abuse reports.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">privacy requests</h2>
    <p class="muted" style="margin:10px 0 0">
      If you want to ask about access, deletion, correction, or opt-out choices related to information we may have received,
      email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and include enough detail for us to understand the request.
      We may need to verify that a request came from the same person who sent the original message before we make changes.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Links to other sites</h2>
    <p class="muted" style="margin:10px 0 0">
      Some pages link to lenders, regulators, issuers, or public resources. Those sites control their own privacy practices,
      and you should review their policies directly before sharing information.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Security and sensitive information</h2>
    <p class="muted" style="margin:10px 0 0">
      We use reasonable administrative and technical safeguards, but no website is perfectly secure. Do not send Social
      Security numbers, account numbers, or other sensitive documents through general contact forms or email.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Policy updates</h2>
    <p class="muted" style="margin:10px 0 0">
      We update this policy when consent behavior, analytics, advertising, or contact handling changes in a material way.
      The visible date above is part of the site's public maintenance trail.
    </p>
  </section>
</BaseLayout>
