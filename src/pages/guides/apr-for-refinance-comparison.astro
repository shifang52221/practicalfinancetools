---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "APR for Mortgage Refinance (How to compare)";
const description =
  "Compare refinance APR offers by aligning fees, term, and break-even horizon. Educational use only.";
---
<BaseLayout title={title} description={description} canonicalPath="/guides/apr-for-refinance-comparison">
  <section class="card hero">
    <span class="pill">Guide</span>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">APR for refinance</span>
    </nav>
    <h1>APR for refinance comparison</h1>
    <p>
      Refinance offers can look similar until you compare fees and break-even. This guide shows how to compare APR and
      total cost with a consistent horizon.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/apr-calculator">APR calculator</a>
      <a class="btn" href="/guides/refinance-break-even">Refinance break-even</a>
      <a class="btn" href="/topics/refinance">Refinance topic</a>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">What to align</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Same loan amount and term.</li>
      <li>Same fee treatment (paid upfront vs rolled in).</li>
      <li>Same break-even horizon.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Why APR matters</h2>
    <p class="muted" style="margin:10px 0 0">
      APR captures the cost of fees and points in a rate-equivalent number. It is useful, but you still need to compare
      total dollars over your expected time horizon.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Common mistakes</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Ignoring closing costs and prepaid items.</li>
      <li>Comparing APR across different terms.</li>
      <li>Assuming you will keep the loan for the full term.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related tools</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/apr-calculator">APR calculator</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/refinance-break-even">Refinance break-even</a></li>
        <li><a href="/guides/apr-when-fees-are-financed">APR when fees are financed</a></li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">FAQ</h2>
    <h3 style="margin:12px 0 0">Is the lowest APR always the best for a refi?</h3>
    <p class="muted" style="margin:8px 0 0">
      Not if you plan to move or refinance again soon. Compare total dollars over your expected horizon.
    </p>
    <h3 style="margin:12px 0 0">Do points change break-even?</h3>
    <p class="muted" style="margin:8px 0 0">
      Yes. Points increase upfront costs, which can push break-even further out.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Next steps</h2>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn btn-primary" href="/guides/refinance-break-even">Run break-even</a>
      <a class="btn" href="/calculators/apr-calculator">Compare APR offers</a>
      <a class="btn" href="/topics/refinance">Refinance topic</a>
    </div>
    <p class="muted" style="margin:12px 0 0">Educational use only. Not financial advice.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-01-30</p>
  </section>
</BaseLayout>
