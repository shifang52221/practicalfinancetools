---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewedByCard from "../../components/ReviewedByCard.astro";
import { SITE } from "../../config/site";

const title = `Guides | ${SITE.name}`;
const description =
  "Practical guides on mortgage, APR, and credit card payoff topics with links to related calculators. Educational use only.";

const lastUpdated = "2026-03-03";
---
<BaseLayout title={title} description={description} canonicalPath="/guides" lastUpdated={lastUpdated}>
  <section class="card hero">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Guides</span>
    </nav>
    <h1>Guides</h1>
    <p>
      Explanations that match how the calculators work. Use these to understand trade-offs, then run your numbers in the tools.
      Start with the <a href="/calculators/credit-card-payoff-calculator">credit card payoff calculator</a>,{" "}
      <a href="/calculators/minimum-payment-payoff-calculator">credit card minimum payment calculator</a>,{" "}
      <a href="/calculators/debt-snowball-calculator">debt snowball calculator</a>,{" "}
      <a href="/calculators/apr-calculator">APR calculator</a>, or{" "}
      <a href="/calculators/extra-payment-calculator">mortgage payoff calculator</a>.
    </p>
    <div class="btn-row" style="margin-top:12px">
      <a class="btn btn-primary" href="/topics">Browse topics</a>
      <a class="btn" href="/calculators">Browse calculators</a>
    </div>
  </section>

  <section class="card section" style="margin-top:18px">
    <h2 style="margin-top:0">Find a guide</h2>
    <div class="form">
      <div class="field field-3">
        <label class="label" for="guide-search">Search guides</label>
        <input id="guide-search" type="search" placeholder="e.g., balance transfer, PMI removal" />
        <div class="hint">Searches titles in the lists below.</div>
      </div>
      <div class="field field-3">
        <label class="label" for="guide-filter">Filter by topic</label>
        <select id="guide-filter">
          <option value="all">All topics</option>
          <option value="credit-cards">Credit cards</option>
          <option value="apr">APR & borrowing costs</option>
          <option value="mortgages">Mortgages</option>
          <option value="dti">Affordability & DTI</option>
          <option value="rent-vs-buy">Rent vs buy</option>
        </select>
      </div>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">How to use these guides</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Start with the guide that matches your question.</li>
      <li>Run the related calculator with a baseline scenario.</li>
      <li>Change one variable at a time to compare outcomes.</li>
      <li>Use the checklist and FAQ sections for pitfalls and edge cases.</li>
    </ul>
  </section>
  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6" data-guide-group="credit-cards">
      <h2 style="margin-top:0">Credit cards</h2>
      <p class="muted" style="margin:8px 0 0">
        Start with the <a href="/calculators/credit-card-payoff-calculator">credit card payoff calculator</a>.
      </p>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/minimum-payment-payoff-calculator">Credit card minimum payment calculator</a></li>
        <li><a href="/calculators/debt-snowball-calculator">Debt snowball calculator</a></li>
        <li><a href="/guides/credit-card-payoff-strategy">Credit card payoff strategy</a></li>
        <li><a href="/guides/debt-snowball-vs-avalanche">Debt snowball vs avalanche</a></li>
        <li><a href="/calculators/credit-card-payoff-calculator">Credit card payoff calculator</a></li>
        <li><a href="/guides/how-credit-card-interest-is-calculated">How credit card interest is calculated</a></li>
        <li><a href="/guides/why-minimum-payments-take-so-long">Why minimum payments take so long</a></li>
        <li><a href="/guides/how-to-use-apr-for-credit-cards">How to use APR for credit cards</a></li>
      </ul>
    </div>
    <div class="card section prose col-6" data-guide-group="apr">
      <h2 style="margin-top:0">APR & borrowing costs</h2>
      <p class="muted" style="margin:8px 0 0">
        Compare offers with the <a href="/calculators/apr-calculator">APR calculator</a>.
      </p>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/apr-vs-interest-rate">APR vs interest rate</a></li>
        <li><a href="/guides/apr-with-origination-fee">APR with origination fee</a></li>
        <li><a href="/guides/discount-points-vs-lender-credits">Discount points vs lender credits</a></li>
        <li><a href="/guides/apr-comparison-checklist">APR comparison checklist</a></li>
        <li><a href="/guides/how-to-find-your-apr">How to find out your APR</a></li>
        <li><a href="/guides/apr-vs-apy-loans">APR vs APY for loans</a></li>
        <li><a href="/guides/apr-by-loan-type">APR by loan type (auto, personal, student, business)</a></li>
        <li><a href="/guides/apr-for-balance-transfers">APR for balance transfers</a></li>
      </ul>
    </div>
  </section>

  <ReviewedByCard
    reviewedBy="Practical Finance Tools Editorial Team"
    reviewerRole="Guide catalog and link quality review"
    reviewedOn="2026-03-03"
  />

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">FAQ</h2>
    <h3 style="margin:12px 0 0">Are the guides personalized advice?</h3>
    <p class="muted" style="margin:8px 0 0">
      No. They explain how calculators work and how to compare scenarios using your own inputs.
    </p>
    <h3 style="margin:12px 0 0">Why are there multiple guides on similar topics?</h3>
    <p class="muted" style="margin:8px 0 0">
      Each guide focuses on a specific decision, such as fees vs rate or extra payments vs recast.
    </p>
  </section>
  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6" data-guide-group="mortgages">
      <h2 style="margin-top:0">Mortgages</h2>
      <p class="muted" style="margin:8px 0 0">
        Use the <a href="/calculators/extra-payment-calculator">mortgage payoff calculator</a> to model extra principal.
      </p>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/how-mortgage-payments-are-calculated">How mortgage payments are calculated</a></li>
        <li><a href="/guides/what-is-piti">What is PITI (mortgage payment breakdown)</a></li>
        <li><a href="/guides/principal-and-interest-vs-escrow">Principal and interest vs escrow</a></li>
        <li><a href="/guides/mortgage-payment-affordability-checklist">Mortgage payment affordability checklist</a></li>
        <li><a href="/guides/rent-vs-buy-break-even">Rent vs buy break-even guide</a></li>
        <li><a href="/guides/extra-mortgage-payments">Extra mortgage payments</a></li>
        <li><a href="/calculators/additional-principal-payment-calculator">Mortgage extra principal calculator</a></li>
        <li><a href="/guides/biweekly-mortgage-program-fees">Biweekly mortgage program fees</a></li>
        <li>
          <a href="/calculators/extra-payment-calculator">Calculate payoff with additional principal</a>
        </li>
        <li><a href="/guides/amortization-with-extra-payments">Amortization with extra payments</a></li>
        <li><a href="/guides/principal-only-extra-payments">Principal-only extra payments</a></li>
        <li><a href="/guides/one-extra-mortgage-payment-per-year">One extra payment per year</a></li>
        <li><a href="/guides/biweekly-vs-extra-principal">Biweekly vs extra principal</a></li>
        <li><a href="/guides/pmi-removal-vs-extra-principal">PMI removal vs extra principal</a></li>
        <li><a href="/guides/mortgage-recast-vs-extra-payments">Recast vs extra payments</a></li>
        <li><a href="/guides/refinance-break-even">Refinance break-even</a></li>
        <li><a href="/guides/refinance-closing-costs">Refinance closing costs</a></li>
        <li><a href="/guides/refinance-checklist">Refinance checklist</a></li>
        <li><a href="/guides/pay-off-mortgage-early-or-invest">Pay off early or invest?</a></li>
      </ul>
    </div>
    <div class="card section prose col-6" data-guide-group="dti">
      <h2 style="margin-top:0">Affordability & DTI</h2>
      <p class="muted" style="margin:8px 0 0">
        Start with the <a href="/calculators/debt-to-income-calculator">DTI calculator</a>.
      </p>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/dti-calculation-step-by-step">DTI calculation step by step</a></li>
        <li><a href="/guides/what-counts-in-dti">What counts in DTI</a></li>
        <li><a href="/guides/dti-housing-payment-piti-includes">Housing payment inputs (PITI, HOA, PMI)</a></li>
        <li><a href="/guides/how-to-improve-dti">How to improve DTI</a></li>
        <li><a href="/guides/credit-card-payoff-strategy">Credit card payoff strategy</a></li>
      </ul>
    </div>
    <div class="card section prose col-6" data-guide-group="rent-vs-buy">
      <h2 style="margin-top:0">Rent vs buy</h2>
      <p class="muted" style="margin:8px 0 0">
        Start with the <a href="/calculators/rent-vs-buy-calculator">rent vs buy calculator</a>.
      </p>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/rent-vs-buy-break-even">Rent vs buy break-even</a></li>
        <li><a href="/guides/rent-vs-buy-checklist">Rent vs buy checklist</a></li>
        <li><a href="/guides/rent-vs-buy-costs-to-include">Costs to include</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Want a guide?</h2>
      <p class="muted" style="margin:10px 0 0">
        Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with the topic you want next (DTI, rent vs buy, refinancing, and more).
      </p>
    </div>
  </section>

  <section class="grid" style="margin-top:18px">
    <a class="card section prose col-6" href="/guides/extra-mortgage-payments">
      <h2 style="margin-top:0">Extra mortgage payments</h2>
      <p class="muted" style="margin:10px 0 0">
        How principal prepayments change amortization, what to ask your lender, and how to compare scenarios.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/amortization-with-extra-payments">
      <h2 style="margin-top:0">Amortization with extra payments</h2>
      <p class="muted" style="margin:10px 0 0">
        What changes in the payment table when you pay extra principal, and why timing matters.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/principal-only-extra-payments">
      <h2 style="margin-top:0">Principal-only extra payments</h2>
      <p class="muted" style="margin:10px 0 0">
        How to ensure extra payments reduce principal (not "paid ahead"), and what to check on your statement.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/one-extra-mortgage-payment-per-year">
      <h2 style="margin-top:0">One extra payment per year</h2>
      <p class="muted" style="margin:10px 0 0">
        Two common ways to model it (monthly vs annual) and what to confirm with your lender.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/biweekly-vs-extra-principal">
      <h2 style="margin-top:0">Biweekly vs extra principal</h2>
      <p class="muted" style="margin:10px 0 0">
        When biweekly payments help, when they don't, and a simple way to compare scenarios.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/pmi-removal-vs-extra-principal">
      <h2 style="margin-top:0">PMI removal vs extra principal</h2>
      <p class="muted" style="margin:10px 0 0">
        When PMI changes the math, what to confirm with your lender, and a practical way to compare.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/mortgage-recast-vs-extra-payments">
      <h2 style="margin-top:0">Recast vs extra payments</h2>
      <p class="muted" style="margin:10px 0 0">
        Extra principal usually shortens payoff time; a recast can lower your required payment after a lump sum.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/refinance-break-even">
      <h2 style="margin-top:0">Refinance break-even</h2>
      <p class="muted" style="margin:10px 0 0">
        A simple framework to compare monthly savings to closing costs and your time horizon.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/pay-off-mortgage-early-or-invest">
      <h2 style="margin-top:0">Pay off early or invest?</h2>
      <p class="muted" style="margin:10px 0 0">
        A practical checklist to compare mortgage prepayments vs investing, including risk and liquidity.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/rent-vs-buy-break-even">
      <h2 style="margin-top:0">Rent vs buy break-even</h2>
      <p class="muted" style="margin:10px 0 0">
        A checklist for setting assumptions and comparing scenarios with the rent vs buy calculator.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/apr-vs-interest-rate">
      <h2 style="margin-top:0">APR vs interest rate</h2>
      <p class="muted" style="margin:10px 0 0">
        What APR includes, how fees change comparisons, and when APR can mislead.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/credit-card-payoff-strategy">
      <h2 style="margin-top:0">Credit card payoff strategy</h2>
      <p class="muted" style="margin:10px 0 0">
        Fixed payments vs minimum payments, what drives interest cost, and how to prioritize multiple debts.
      </p>
    </a>
    <a class="card section prose col-6" href="/guides/debt-snowball-vs-avalanche">
      <h2 style="margin-top:0">Debt snowball vs avalanche</h2>
      <p class="muted" style="margin:10px 0 0">
        A simple framework to choose the method that fits your goals and payment habits.
      </p>
    </a>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Want a guide?</h2>
      <p class="muted" style="margin:10px 0 0">
        Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with the topic you want next (DTI, rent vs buy, refinancing, and more).
      </p>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Updates</h2>
    <p class="muted" style="margin:10px 0 0">Guides are updated as calculators change or new scenarios are added.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-03-03</p>
  </section>

  <script is:inline type="text/javascript">
    (function () {
      var search = document.getElementById("guide-search");
      var filter = document.getElementById("guide-filter");
      if (!search || !filter) return;

      var groups = Array.prototype.slice.call(document.querySelectorAll("[data-guide-group]"));
      var links = Array.prototype.slice.call(document.querySelectorAll("[data-guide-group] a"));
      links.forEach(function (link) {
        link.setAttribute("data-astro-prefetch", "false");
      });

      function applyFilters() {
        var q = (search.value || "").trim().toLowerCase();
        var f = filter.value || "all";

        groups.forEach(function (group) {
          var groupId = group.getAttribute("data-guide-group") || "";
          var groupMatches = f === "all" || f === groupId;
          var items = group.querySelectorAll("li");
          var anyVisible = false;

          items.forEach(function (li) {
            if (!q) {
              li.hidden = false;
              anyVisible = true;
              return;
            }
            var text = (li.textContent || "").toLowerCase();
            var match = text.indexOf(q) !== -1;
            li.hidden = !match;
            if (match) anyVisible = true;
          });

          group.hidden = !groupMatches || (q && !anyVisible);
        });
      }

      search.addEventListener("input", applyFilters);
      filter.addEventListener("change", applyFilters);
      applyFilters();
    })();
  </script>
</BaseLayout>



