  <script is:inline type="text/javascript">
    (function () {
      var search = document.getElementById("guide-search");
      var filter = document.getElementById("guide-filter");
      if (!search || !filter) return;

      var groups = Array.prototype.slice.call(document.querySelectorAll("[data-guide-group]"));
      var links = Array.prototype.slice.call(document.querySelectorAll("[data-guide-group] a"));
      links.forEach(function (link) {
        link.setAttribute("data-astro-prefetch", "false");
      });

      function applyFilters() {
        var q = (search.value || "").trim().toLowerCase();
        var f = filter.value || "all";

        groups.forEach(function (group) {
          var groupId = group.getAttribute("data-guide-group") || "";
          var groupMatches = f === "all" || f === groupId;
          var items = group.querySelectorAll("li");
          var anyVisible = false;

          items.forEach(function (li) {
            if (!q) {
              li.hidden = false;
              anyVisible = true;
              return;
            }
            var text = (li.textContent || "").toLowerCase();
            var match = text.indexOf(q) !== -1;
            li.hidden = !match;
            if (match) anyVisible = true;
          });

          group.hidden = !groupMatches || (q && !anyVisible);
        });
      }

      search.addEventListener("input", applyFilters);
      filter.addEventListener("change", applyFilters);
      applyFilters();
    })();
  </script>
