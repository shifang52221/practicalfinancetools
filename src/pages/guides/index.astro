---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";

const title = `Guides | ${SITE.name}`;
const description =
  "Practical guides on mortgage, APR, and credit card payoff topics with links to related calculators. Educational use only.";

const lastUpdated = "2026-01-30";
---
<BaseLayout title={title} description={description} canonicalPath="/guides" lastUpdated={lastUpdated}>
  <section class="card hero">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Guides</span>
    </nav>
    <h1>Guides</h1>
    <p>
      Explanations that match how the calculators work. Use these to understand trade-offs, then run your numbers in the tools.
      Start with the <a href="/calculators/credit-card-payoff-calculator">credit card payoff calculator</a>,{" "}
      <a href="/calculators/apr-calculator">APR calculator</a>, or{" "}
      <a href="/calculators/extra-payment-calculator">mortgage payoff calculator</a>.
    </p>
    <div class="btn-row" style="margin-top:12px">
      <a class="btn btn-primary" href="/topics">Browse topics</a>
      <a class="btn" href="/calculators">Browse calculators</a>
    </div>
  </section>

  <section class="card section" style="margin-top:18px">
    <h2 style="margin-top:0">Find a guide</h2>
    <div class="form">
      <div class="field field-3">
        <label class="label" for="guide-search">Search guides</label>
        <input id="guide-search" type="search" placeholder="e.g., balance transfer, PMI removal" />
        <div class="hint">Searches titles in the lists below.</div>
      </div>
      <div class="field field-3">
        <label class="label" for="guide-filter">Filter by topic</label>
        <select id="guide-filter">
          <option value="all">All topics</option>
          <option value="credit-cards">Credit cards</option>
          <option value="apr">APR & borrowing costs</option>
          <option value="mortgages">Mortgages</option>
          <option value="dti">Affordability & DTI</option>
          <option value="rent-vs-buy">Rent vs buy</option>
        </select>
      </div>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">How to use these guides</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Start with the guide that matches your question.</li>
      <li>Run the related calculator with a baseline scenario.</li>
      <li>Change one variable at a time to compare outcomes.</li>
      <li>Use the checklist and FAQ sections for pitfalls and edge cases.</li>
    </ul>
  </section>
  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6" data-guide-group="credit-cards">
