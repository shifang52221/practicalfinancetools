---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "APR and Prepayment (Why horizon matters)";
const description =
  "APR assumes a full-term schedule. Learn how prepayment changes the comparison. Educational use only.";
---
<BaseLayout title={title} description={description} canonicalPath="/guides/apr-and-prepayment">
  <section class="card hero">
    <span class="pill">Guide</span>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">APR and prepayment</span>
    </nav>
    <h1>APR and prepayment</h1>
    <p>
      APR assumes the full repayment schedule. If you plan to prepay or refinance early, total cost can differ. This guide
      shows how to compare offers using your time horizon.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/apr-calculator">APR calculator</a>
      <a class="btn" href="/guides/apr-comparison-checklist">APR comparison checklist</a>
      <a class="btn" href="/topics/apr">APR topic</a>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Why horizon matters</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Upfront fees are spread over the full term in APR.</li>
      <li>Early payoff makes those fees more expensive per year.</li>
      <li>Compare total dollars paid over your expected horizon.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">How to compare offers</h2>
    <ol class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Calculate APR for each offer.</li>
      <li>Estimate total cost over 3, 5, or 7 years.</li>
      <li>Pick the offer with the lowest cost over that period.</li>
    </ol>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Common mistakes</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Using APR alone when you plan to refinance soon.</li>
      <li>Ignoring prepayment penalties.</li>
      <li>Comparing offers across different terms.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related tools</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/apr-calculator">APR calculator</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/apr-when-fees-are-financed">APR when fees are financed</a></li>
        <li><a href="/guides/discount-points-vs-lender-credits">Points vs credits</a></li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">FAQ</h2>
    <h3 style="margin:12px 0 0">Is a lower APR always better?</h3>
    <p class="muted" style="margin:8px 0 0">
      Not if you plan to pay off early. Compare total dollars over your horizon.
    </p>
    <h3 style="margin:12px 0 0">Does APR account for prepayments?</h3>
    <p class="muted" style="margin:8px 0 0">
      No. APR assumes the full schedule. That is why horizon-based comparisons are important.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Next steps</h2>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn btn-primary" href="/calculators/apr-calculator">Compare APR offers</a>
      <a class="btn" href="/guides/apr-comparison-checklist">APR comparison checklist</a>
      <a class="btn" href="/topics/apr">APR topic</a>
    </div>
    <p class="muted" style="margin:12px 0 0">Educational use only. Not financial advice.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-01-30</p>
  </section>
</BaseLayout>
