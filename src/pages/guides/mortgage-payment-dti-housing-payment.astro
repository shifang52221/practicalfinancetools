---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Mortgage Payment in DTI Calculations";
const description =
  "How to use the full housing payment (PITI + HOA + PMI) in DTI and affordability checks. Educational use only.";
---
<BaseLayout title={title} description={description} canonicalPath="/guides/mortgage-payment-dti-housing-payment">
  <section class="card hero">
    <span class="pill">Guide</span>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">DTI housing payment</span>
    </nav>
    <h1>Mortgage payment in DTI calculations</h1>
    <p>
      DTI should include the full housing payment: principal, interest, taxes, insurance, HOA, and PMI. This guide shows how to
      build that number so your affordability checks are realistic.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/debt-to-income-calculator">DTI calculator</a>
      <a class="btn" href="/calculators/mortgage-payment-calculator">Mortgage payment calculator</a>
      <a class="btn" href="/topics/debt-to-income">DTI topic hub</a>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">What to include</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Principal and interest (P&amp;I).</li>
      <li>Property taxes and homeowners insurance.</li>
      <li>HOA dues if applicable.</li>
      <li>PMI or mortgage insurance if required.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Front-end vs back-end DTI</h2>
    <p class="muted" style="margin:10px 0 0">
      Front-end DTI uses the housing payment only. Back-end DTI includes housing plus other required debts. Make sure you know which
      ratio you are comparing.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Common mistakes</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Leaving out taxes or insurance from the housing payment.</li>
      <li>Using a guessed payment instead of a calculator estimate.</li>
      <li>Mixing front-end and back-end ratios in comparisons.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Where to get the numbers</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Loan Estimate or Closing Disclosure for escrow items.</li>
      <li>Property tax bill or county rate estimates.</li>
      <li>Insurance quotes for annual premium estimates.</li>
      <li>HOA documents for dues and assessments.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Inputs to double-check</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Monthly taxes and insurance after escrow adjustments.</li>
      <li>Any PMI or mortgage insurance premium changes.</li>
      <li>HOA dues that increase annually or quarterly.</li>
      <li>Planned rate changes if using an ARM scenario.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related tools</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/debt-to-income-calculator">DTI calculator</a></li>
        <li><a href="/calculators/mortgage-payment-calculator">Mortgage payment calculator</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/front-end-vs-back-end-dti">Front-end vs back-end DTI</a></li>
        <li><a href="/guides/what-is-piti">What is PITI?</a></li>
        <li><a href="/guides/mortgage-payment-affordability-checklist">Mortgage payment affordability checklist</a></li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Next steps</h2>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn btn-primary" href="/calculators/debt-to-income-calculator">Run the DTI calculator</a>
      <a class="btn" href="/calculators/mortgage-payment-calculator">Estimate the payment</a>
      <a class="btn" href="/topics/debt-to-income">DTI topic hub</a>
    </div>
    <p class="muted" style="margin:12px 0 0">Educational use only. Not financial advice.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-01-31</p>
  </section>
</BaseLayout>
