---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Liquidity Reserve Check for Extra Payments";
const description =
  "How to keep cash reserves while making extra mortgage payments. Educational use only.";
---
<BaseLayout title={title} description={description} canonicalPath="/guides/extra-payment-liquidity-reserve">
  <section class="card hero">
    <span class="pill">Guide</span>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Liquidity reserve</span>
    </nav>
    <h1>Liquidity reserve check before extra payments</h1>
    <p>
      Extra payments reduce interest, but they also reduce liquid cash. Use this guide to keep a reserve and avoid overextending.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/guides/mortgage-payment-affordability-checklist">Affordability checklist</a>
      <a class="btn" href="/calculators/extra-payment-calculator">Extra payment calculator</a>
      <a class="btn" href="/topics/mortgage-payoff">Mortgage payoff topic hub</a>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Reserve checklist</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Keep a cash buffer for emergencies and repairs.</li>
      <li>Account for upcoming major expenses or income changes.</li>
      <li>Make extra payments only with funds beyond that reserve.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Common mistakes</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Using all cash to prepay the mortgage.</li>
      <li>Ignoring upcoming taxes, insurance renewals, or repairs.</li>
      <li>Setting a monthly extra that is not sustainable.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">How to size a reserve</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Keep a baseline in months of essential expenses.</li>
      <li>Set aside a separate home maintenance buffer.</li>
      <li>Increase reserves if income is variable or seasonal.</li>
      <li>Only prepay with cash above the target reserve.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related tools</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/extra-payment-calculator">Extra payment calculator</a></li>
        <li><a href="/calculators/mortgage-payment-calculator">Mortgage payment calculator</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/extra-payment-windfall-strategy">Windfall strategy</a></li>
        <li><a href="/guides/extra-payment-priority-vs-other-debts">Priority vs other debts</a></li>
        <li><a href="/guides/pay-off-mortgage-early-or-invest">Pay off early or invest?</a></li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Next steps</h2>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn btn-primary" href="/calculators/extra-payment-calculator">Model sustainable extras</a>
      <a class="btn" href="/guides/extra-payment-windfall-strategy">Windfall strategy</a>
      <a class="btn" href="/topics/mortgage-payoff">Mortgage payoff topic hub</a>
    </div>
    <p class="muted" style="margin:12px 0 0">Educational use only. Not financial advice.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-01-31</p>
  </section>
</BaseLayout>
