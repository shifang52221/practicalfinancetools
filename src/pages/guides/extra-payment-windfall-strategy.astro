---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Windfall Extra Payment Strategy";
const description =
  "How to use a bonus or windfall for a mortgage extra payment while keeping liquidity in mind. Educational use only.";
---
<BaseLayout title={title} description={description} canonicalPath="/guides/extra-payment-windfall-strategy">
  <section class="card hero">
    <span class="pill">Guide</span>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Windfall strategy</span>
    </nav>
    <h1>Using a windfall for extra mortgage payments</h1>
    <p>
      Bonuses and windfalls can accelerate payoff, but only if you preserve enough cash for reserves. This guide outlines a simple
      framework to decide how much to apply as extra principal.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/extra-payment-calculator">Extra payment calculator</a>
      <a class="btn" href="/guides/extra-payment-liquidity-reserve">Liquidity reserve check</a>
      <a class="btn" href="/topics/mortgage-payoff">Mortgage payoff topic hub</a>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Step-by-step framework</h2>
    <ol class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Set aside an emergency reserve first.</li>
      <li>Check any prepayment penalties or rules.</li>
      <li>Model a lump sum using the extra payment calculator.</li>
      <li>Compare to a smaller monthly extra over time.</li>
    </ol>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Common mistakes</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Using all cash and leaving no reserves.</li>
      <li>Forgetting to specify principal-only application.</li>
      <li>Ignoring the time horizon if a refinance is likely.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related tools</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/extra-payment-calculator">Extra payment calculator</a></li>
        <li><a href="/calculators/mortgage-payment-calculator">Mortgage payment calculator</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/extra-payment-lump-sum-vs-monthly">Lump sum vs monthly</a></li>
        <li><a href="/guides/extra-payment-prepayment-penalty-checklist">Prepayment penalty checklist</a></li>
        <li><a href="/guides/pay-off-mortgage-early-or-invest">Pay off early or invest?</a></li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Next steps</h2>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn btn-primary" href="/calculators/extra-payment-calculator">Model a lump sum</a>
      <a class="btn" href="/guides/extra-payment-liquidity-reserve">Liquidity reserve check</a>
      <a class="btn" href="/topics/mortgage-payoff">Mortgage payoff topic hub</a>
    </div>
    <p class="muted" style="margin:12px 0 0">Educational use only. Not financial advice.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-01-30</p>
  </section>
</BaseLayout>
