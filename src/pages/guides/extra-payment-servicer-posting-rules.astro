---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewedByCard from "../../components/ReviewedByCard.astro";
import { TRUST_PROFILES } from "../../config/trust";

const title = "Extra Payments and Servicer Posting Rules";
const description =
  "Extra payment servicer posting rules: make sure extras apply to principal and not paid ahead. Educational use only.";

const lastUpdated = "2026-06-26";
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/guides/extra-payment-servicer-posting-rules"
  lastUpdated={lastUpdated}
  robots="noindex, follow"
  authorProfile={TRUST_PROFILES.siteOwner}
  reviewProfiles={[TRUST_PROFILES.editorialReview, TRUST_PROFILES.methodologyReview]}
>
  <section class="card hero">
    <span class="pill">Guide</span>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Posting rules</span>
    </nav>
    <h1>Extra payments and servicer posting rules</h1>
    <p>
      Extra payments only help if they are applied to principal. This guide shows how to confirm posting rules and avoid "paid ahead"
      treatment.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/guides/principal-only-extra-payments">Principal-only checklist</a>
      <a class="btn" href="/calculators/extra-payment-calculator">Extra payment calculator</a>
      <a class="btn" href="/topics/mortgage-payoff">Mortgage payoff topic hub</a>
    </div>
  </section>

  <ReviewedByCard
    writtenBy={TRUST_PROFILES.siteOwner}
    reviewedBy={TRUST_PROFILES.editorialReview}
    secondaryReview={TRUST_PROFILES.methodologyReview}
    reviewScope="Principal-only posting verification, paid-ahead handling, and routing between the main extra-payment guide and the operational checklist."
    reviewedOn={lastUpdated}
  />

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">How this page fits the extra-payment workflow</h2>
    <p class="muted" style="margin:10px 0 0">
      Use this support page for one narrow operational question: did the servicer apply the payment to principal the way you expected?
      If you still need the broader payoff strategy, start with the <a href="/guides/extra-mortgage-payments">main extra payment guide</a>.
      If you already know the issue is lender handling, move to <a href="/guides/principal-only-extra-payments">principal-only extra payments</a> for the stronger step-by-step checklist.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Posting checklist</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Confirm the extra amount is labeled "principal only".</li>
      <li>Check the payment history for principal reduction.</li>
      <li>Ask if the servicer offers a principal-only toggle.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Servicer posting inputs to confirm</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>How the portal labels principal-only payments.</li>
      <li>Whether "paid ahead" is enabled by default.</li>
      <li>Posting date vs draft date timing.</li>
      <li>Split between regular payment and extra amount.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Common mistakes</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Assuming all extra payments are principal-only by default.</li>
      <li>Sending extras with the monthly payment without instructions.</li>
      <li>Not checking the posting date and allocation on statements.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">What to tell the servicer</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Specify "apply extra to principal only".</li>
      <li>Ask if "paid ahead" will be disabled.</li>
      <li>Confirm how to split regular payment and extra.</li>
      <li>Request written confirmation of posting rules.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Proof to keep on file</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Payment confirmation showing the extra amount.</li>
      <li>Statement line item with principal-only allocation.</li>
      <li>Servicer email or message confirming the instructions.</li>
      <li>Any online setting that toggles principal-only payments.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">If a payment is misapplied</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Contact the servicer and request a principal-only correction.</li>
      <li>Ask for the adjustment to appear on the next statement.</li>
      <li>Keep written confirmation of the change.</li>
      <li>Re-check the amortization schedule after the fix.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Decision inputs</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Exact extra amount and the date it should post.</li>
      <li>Whether your servicer allows recurring principal-only instructions.</li>
      <li>Any paid-ahead settings on the account.</li>
      <li>How the servicer splits the regular payment and the extra.</li>
      <li>Evidence you can save if a dispute is needed.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Scenario checklist</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Test one manual extra payment and verify posting.</li>
      <li>Set a recurring principal-only instruction if supported.</li>
      <li>Confirm paid-ahead stays off after the next statement.</li>
      <li>Re-check allocation after any servicer change.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related tools</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/extra-payment-calculator">Extra payment calculator</a></li>
        <li><a href="/calculators/amortization-schedule-calculator">Amortization schedule</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/principal-only-extra-payments">Principal-only extra payments</a></li>
        <li><a href="/guides/extra-mortgage-payments">Extra mortgage payments</a></li>
        <li><a href="/guides/extra-payment-prepayment-penalty-checklist">Prepayment penalty checklist</a></li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Next steps</h2>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn btn-primary" href="/guides/principal-only-extra-payments">Principal-only checklist</a>
      <a class="btn" href="/guides/extra-mortgage-payments">Main extra payment guide</a>
      <a class="btn" href="/topics/mortgage-payoff">Mortgage payoff topic hub</a>
    </div>
    <p class="muted" style="margin:12px 0 0">Educational use only. Not financial advice.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-06-26</p>
  </section>
</BaseLayout>
