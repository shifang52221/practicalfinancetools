---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Discount Points vs Lender Credits";
const description =
  "Compare discount points and lender credits using APR and your time horizon. Educational use only.";

const lastUpdated = "2026-01-31";
---
<BaseLayout title={title} description={description} canonicalPath="/guides/discount-points-vs-lender-credits" lastUpdated={lastUpdated}>
  <section class="card hero">
    <span class="pill">Guide</span>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Points vs credits</span>
    </nav>
    <h1>Discount points vs lender credits</h1>
    <p>
      Points lower the rate but increase upfront cost. Lender credits reduce upfront cost but raise the rate. This guide
      shows how to compare them using APR and your time horizon.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/apr-calculator">APR calculator</a>
      <a class="btn" href="/guides/apr-with-origination-fee">APR with origination fee</a>
      <a class="btn" href="/topics/apr">APR topic</a>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">How points and credits work</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li><strong>Points:</strong> pay more upfront for a lower rate.</li>
      <li><strong>Credits:</strong> pay less upfront for a higher rate.</li>
      <li>The best option depends on how long you keep the loan.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Comparison checklist</h2>
    <ol class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Use the same loan amount and term.</li>
      <li>Compare monthly payment and total cost over your horizon.</li>
      <li>Check APR to see how fees change the effective rate.</li>
    </ol>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Decision inputs</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Cash-to-close budget vs monthly payment target.</li>
      <li>Expected years in the loan before refi or sale.</li>
      <li>Points cost or credit amount in dollars.</li>
      <li>Any lender credits tied to a higher rate.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Break-even checklist</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Calculate monthly savings from the lower rate.</li>
      <li>Divide points cost by monthly savings for break-even months.</li>
      <li>Compare break-even to your planned horizon.</li>
      <li>Re-run if rates or fees change.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Scenario checklist</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Model a no-points offer as a baseline.</li>
      <li>Model a points offer with the same term.</li>
      <li>Include lender credits in the cash-to-close.</li>
      <li>Compare total dollars paid by your horizon.</li>
      <li>Revisit if you may refinance early.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Common mistakes</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Choosing points without considering your horizon.</li>
      <li>Comparing APRs across different terms.</li>
      <li>Ignoring cash-to-close constraints.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related tools</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/apr-calculator">APR calculator</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/interest-rate-apr-calculator">Interest rate vs APR</a></li>
        <li><a href="/guides/apr-when-fees-are-financed">APR when fees are financed</a></li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">FAQ</h2>
    <h3 style="margin:12px 0 0">Do points always lower APR?</h3>
    <p class="muted" style="margin:8px 0 0">
      Often yes, but the benefit depends on term and fee size. Compare both options.
    </p>
    <h3 style="margin:12px 0 0">Do lender credits change APR?</h3>
    <p class="muted" style="margin:8px 0 0">
      Yes, because credits change the effective rate and fees. APR can help compare options.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Next steps</h2>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn btn-primary" href="/calculators/apr-calculator">Compare APR</a>
      <a class="btn" href="/guides/apr-with-origination-fee">APR with origination fee</a>
      <a class="btn" href="/topics/apr">APR topic</a>
    </div>
    <p class="muted" style="margin:12px 0 0">Educational use only. Not financial advice.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-01-31</p>
  </section>
</BaseLayout>

