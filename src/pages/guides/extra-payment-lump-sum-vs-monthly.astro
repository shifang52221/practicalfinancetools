---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReviewedByCard from "../../components/ReviewedByCard.astro";
import { TRUST_PROFILES } from "../../config/trust";
import { amortizationSchedule } from "../../lib/calc/loan";

const title = "Lump Sum vs Monthly Extra Mortgage Payments";
const description =
  "How to compare a lump-sum principal payment with recurring monthly extras using the same mortgage baseline and timing assumptions. Educational use only.";

const examplePrincipal = 300000;
const exampleRate = 6.5;
const exampleTermMonths = 360;
const exampleLumpSum = 6000;
const exampleMonthlyExtra = 500;
const exampleMonthlyExtraEndMonth = 12;

const base = amortizationSchedule({
  principal: examplePrincipal,
  aprPercent: exampleRate,
  termMonths: exampleTermMonths
});
const monthlySpread = amortizationSchedule({
  principal: examplePrincipal,
  aprPercent: exampleRate,
  termMonths: exampleTermMonths,
  extraMonthly: exampleMonthlyExtra,
  extraMonthlyEndMonth: exampleMonthlyExtraEndMonth
});
const earlyLump = amortizationSchedule({
  principal: examplePrincipal,
  aprPercent: exampleRate,
  termMonths: exampleTermMonths,
  extraOneTime: exampleLumpSum,
  extraOneTimeMonth: 1
});
const lateLump = amortizationSchedule({
  principal: examplePrincipal,
  aprPercent: exampleRate,
  termMonths: exampleTermMonths,
  extraOneTime: exampleLumpSum,
  extraOneTimeMonth: 12
});

const money0 = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 0,
  maximumFractionDigits: 0
});
const pct2 = new Intl.NumberFormat("en-US", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2
});
const yearsMonths = (months: number) => ({
  years: Math.floor(months / 12),
  months: months % 12
});
const baseYm = yearsMonths(base.months);
const monthlyYm = yearsMonths(monthlySpread.months);
const earlyYm = yearsMonths(earlyLump.months);
const lateYm = yearsMonths(lateLump.months);

const lastUpdated = "2026-04-05";
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/guides/extra-payment-lump-sum-vs-monthly"
  lastUpdated={lastUpdated}
  authorProfile={TRUST_PROFILES.siteOwner}
  reviewProfiles={[TRUST_PROFILES.methodologyReview, TRUST_PROFILES.editorialReview]}
>
  <section class="card hero">
    <span class="pill">Guide</span>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides">Guides</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Lump sum vs monthly</span>
    </nav>
    <h1>Lump sum vs monthly extra payments</h1>
    <p>
      The total extra dollars are not the whole story. A lump sum, a steady monthly extra, and a delayed year-end payment can all
      produce different payoff results because mortgage interest depends on when principal is reduced.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/additional-principal-payment-calculator">Model a lump sum</a>
      <a class="btn" href="/calculators/extra-payment-calculator">Model monthly extras</a>
      <a class="btn" href="/guides/one-extra-mortgage-payment-per-year">One extra payment per year</a>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">What this guide now owns</h2>
    <p class="muted" style="margin:10px 0 0">
      This page now owns the timing choice between a lump sum and recurring monthly extras. If the cash is a windfall, use the windfall
      page first to split the money, then come back here for the timing comparison.
    </p>
  </section>

  <ReviewedByCard
    writtenBy={TRUST_PROFILES.siteOwner}
    reviewedBy={TRUST_PROFILES.methodologyReview}
    secondaryReview={TRUST_PROFILES.editorialReview}
    reviewScope="Timing differences between early lump sums and recurring extras, equal-dollar comparison framing, and routing between additional-principal, annual-extra, and broader payoff workflows."
    reviewedOn="2026-04-05"
  />

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Use this guide when timing is the main reason a lump sum and recurring extra could produce different payoff results</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Use this page when you already know how much extra cash you have, but the timing of that cash is changing the better strategy.</li>
      <li>Use this page when you want to compare equal-dollar scenarios instead of guessing from a generic rule of thumb.</li>
      <li>If your main question is whether extra payments fit your budget at all, check <a href="/guides/extra-payment-liquidity-reserve">liquidity reserve</a> first.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">A lump sum tends to win when</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li>The cash is already available and can be applied to principal now.</li>
        <li>You want the balance reduction immediately instead of over several months.</li>
        <li>You have already checked liquidity and do not need the cash for short-term shocks.</li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Monthly extras tend to win when</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li>The cash arrives gradually through paychecks rather than sitting in savings already.</li>
        <li>You want a sustainable habit that can start immediately instead of waiting for a future bonus or refund.</li>
        <li>You want more flexibility to pause or adjust the plan if income changes.</li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Worked example: same total dollars, different timing</h2>
    <p class="muted" style="margin:10px 0 0">
      Example: {money0.format(examplePrincipal)} at {pct2.format(exampleRate)}% note rate for {exampleTermMonths / 12} years. Compare
      the same {money0.format(exampleLumpSum)} total extra contribution in three ways.
    </p>
    <div style="overflow:auto; margin-top:12px">
      <table class="table">
        <thead>
          <tr>
            <th>Scenario</th>
            <th class="num">Payoff time</th>
            <th class="num">Total interest</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Baseline with no extra</td>
            <td class="num">{base.months} months ({baseYm.years}y {baseYm.months}m)</td>
            <td class="num">{money0.format(base.totalInterest)}</td>
          </tr>
          <tr>
            <td>{money0.format(exampleMonthlyExtra)}/month for 12 months</td>
            <td class="num">{monthlySpread.months} months ({monthlyYm.years}y {monthlyYm.months}m)</td>
            <td class="num">{money0.format(monthlySpread.totalInterest)}</td>
          </tr>
          <tr>
            <td>{money0.format(exampleLumpSum)} lump sum in month 1</td>
            <td class="num">{earlyLump.months} months ({earlyYm.years}y {earlyYm.months}m)</td>
            <td class="num">{money0.format(earlyLump.totalInterest)}</td>
          </tr>
          <tr>
            <td>{money0.format(exampleLumpSum)} lump sum in month 12</td>
            <td class="num">{lateLump.months} months ({lateYm.years}y {lateYm.months}m)</td>
            <td class="num">{money0.format(lateLump.totalInterest)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin:12px 0 0">
      In this example, the earliest lump sum produces the most savings because it reduces principal immediately. The monthly-extra path
      still beats waiting until month 12 because some of the principal reduction happens earlier.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">How to compare fairly</h2>
    <ol class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Use the same starting balance, note rate, and remaining term in every scenario.</li>
      <li>Match the total extra dollars before comparing payoff time or interest savings.</li>
      <li>Use realistic posting months for the lump sum instead of assuming it arrives at the start of the year.</li>
      <li>Check that every extra payment is applied to principal-only so the timing comparison is real.</li>
    </ol>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Common mistakes</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>Comparing a late lump sum with monthly extras that start now, then treating them as equal timing.</li>
      <li>Ignoring liquidity and using a lump sum that should have stayed in reserve.</li>
      <li>Assuming the servicer will post the extra the same day you schedule it without checking statement timing.</li>
      <li>Forgetting that a refinance or sale horizon can shrink the value of a long payoff plan.</li>
    </ul>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related tools</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/calculators/additional-principal-payment-calculator">Additional principal calculator</a></li>
        <li><a href="/calculators/extra-payment-calculator">Extra payment calculator</a></li>
        <li><a href="/calculators/amortization-schedule-calculator">Amortization schedule</a></li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Related guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li><a href="/guides/extra-payment-target-payoff-date">Target payoff date</a></li>
        <li><a href="/guides/principal-only-extra-payments">Principal-only extra payments</a></li>
        <li><a href="/guides/extra-mortgage-payments">Extra mortgage payments</a></li>
      </ul>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">References</h2>
    <ul class="muted" style="margin:10px 0 0; padding-left:18px">
      <li>
        CFPB:{" "}
        <a href="https://www.consumerfinance.gov/consumer-tools/mortgages/" rel="noopener noreferrer" target="_blank">
          Mortgage resources
        </a>
      </li>
      <li>
        CFPB:{" "}
        <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-prepayment-penalty-en-1957/" rel="noopener noreferrer" target="_blank">
          What is a prepayment penalty?
        </a>
      </li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Next steps</h2>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn btn-primary" href="/calculators/additional-principal-payment-calculator">Run the lump-sum scenario</a>
      <a class="btn" href="/calculators/extra-payment-calculator">Compare a recurring extra</a>
      <a class="btn" href="/topics/mortgage-payoff">Mortgage payoff topic hub</a>
    </div>
    <p class="muted" style="margin:12px 0 0">Educational use only. Not financial advice.</p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-04-05</p>
  </section>
</BaseLayout>
