---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewedByCard from "../components/ReviewedByCard.astro";
import { SITE } from "../config/site";
import { TOOLS } from "../lib/tools";
import AdSlot from "../components/AdSlot.astro";

const title = `${SITE.name} | Free US Finance Calculators`;
const description =
  "Practical, fast calculators for credit card payoff, APR calculator comparisons, mortgage payoff planning, and rent vs buy. Educational use only.";

const featuredSlugs = [
  "minimum-payment-payoff-calculator",
  "apr-calculator",
  "biweekly-mortgage-payment-calculator",
  "extra-payment-calculator",
  "credit-card-payoff-calculator",
  "mortgage-payment-calculator"
];

const featured = TOOLS.filter((t) => featuredSlugs.includes(t.slug));
const all = TOOLS;
const slots = SITE.adsenseSlots;
---
<BaseLayout title={title} description={description} canonicalPath="/">
  <section class="card hero">
    <span class="pill">US-focused - Decision-first - No signup</span>
    <h1>Choose the right calculator for payoff, APR, and mortgage decisions</h1>
    <p>
      Estimate payoff timelines, interest cost, and payment schedules with clear assumptions. Your inputs stay in your
      browser and results are educational only. If you are trying to pay off credit cards, compare loan offers, or plan
      extra mortgage payments, start with a workflow below instead of browsing the whole catalog.
    </p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/topics/credit-cards">Start credit-card payoff</a>
      <a class="btn" href="/topics/apr">Compare APR offers</a>
      <a class="btn" href="/topics/mortgage-payoff">Plan mortgage payoff</a>
      <a class="btn" href="/about">About this site</a>
    </div>
  </section>

  <ReviewedByCard
    reviewedBy="Practical Finance Tools Editorial Team"
    reviewerRole="Sitewide workflow and methodology review"
    reviewedOn="2026-04-03"
  />

  <section class="card section" style="margin-top:18px">
    <h2 style="margin:0 0 12px">Start with a workflow</h2>
    <p class="muted" style="margin:0 0 12px">
      These are the three clusters currently carrying the clearest search demand and the strongest practical user intent.
    </p>
    <div class="grid">
      <a class="card2 tool col-6" href="/topics/credit-cards">
        <div class="tool-title">Credit card payoff and minimum payments</div>
        <div class="tool-desc">
          Start with payoff math, minimum-payment risk, and snowball vs avalanche in one guided flow.
        </div>
        <div class="muted" style="font-size:12px; margin-top:4px">Best entry points: payoff, minimum payment, snowball</div>
      </a>
      <a class="card2 tool col-6" href="/topics/apr">
        <div class="tool-title">APR comparisons and borrowing costs</div>
        <div class="tool-desc">
          Compare offers with fees, points, and lender credits without mixing terms or cash-to-close assumptions.
        </div>
        <div class="muted" style="font-size:12px; margin-top:4px">Best entry points: APR calculator, APR vs rate</div>
      </a>
      <a class="card2 tool col-6" href="/topics/mortgage-payoff">
        <div class="tool-title">Mortgage payoff, biweekly, and extra principal</div>
        <div class="tool-desc">
          Work from baseline payment to amortization, monthly extra, lump sum, and biweekly comparisons.
        </div>
        <div class="muted" style="font-size:12px; margin-top:4px">Best entry points: extra payments, biweekly, principal-only</div>
      </a>
    </div>
  </section>

  <section class="card section">
    <h2 style="margin:0 0 12px">Core calculators</h2>
    <p class="muted" style="margin:0 0 12px">
      Highest-priority tools for this site right now: <a href="/calculators/minimum-payment-payoff-calculator">minimum payment</a>,{" "}
      <a href="/calculators/apr-calculator">APR calculator</a>,{" "}
      <a href="/calculators/biweekly-mortgage-payment-calculator">biweekly mortgage</a>, and{" "}
      <a href="/calculators/extra-payment-calculator">extra payment mortgage</a>.
    </p>
    <div class="grid">
      {featured.map((t) => (
        <a class="card2 tool col-6" href={`/calculators/${t.slug}`}>
          <div class="tool-title">{t.title}</div>
          <div class="tool-desc">{t.description}</div>
          <div class="muted" style="font-size:12px; margin-top:4px">{t.category}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Choose the right calculator first</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li>
          Minimum-payment risk: use <a href="/calculators/minimum-payment-payoff-calculator">Minimum Payment Payoff</a>.
        </li>
        <li>
          Fixed-payment credit-card plan: use <a href="/calculators/credit-card-payoff-calculator">Credit Card Payoff</a>.
        </li>
        <li>
          Borrowing comparisons: use <a href="/calculators/apr-calculator">APR Calculator</a> to include fees.
        </li>
        <li>
          Biweekly vs monthly extra: use <a href="/calculators/biweekly-mortgage-payment-calculator">Biweekly Mortgage</a>.
        </li>
        <li>
          General mortgage payoff: use <a href="/calculators/extra-payment-calculator">Extra Payment Mortgage</a>.
        </li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">How to use results safely</h2>
      <p class="muted" style="margin:10px 0 0">
        Use outputs to compare scenarios (payment size, extra payments, APRs), not as exact lender quotes. Always confirm
        final terms, escrow, and fees with your lender or card issuer.
      </p>
      <p class="muted" style="margin:10px 0 0">
        Working on a mortgage payoff plan? Start with your <a href="/calculators/mortgage-payment-calculator">monthly payment</a>, then
        compare <a href="/calculators/extra-payment-calculator">extra principal payments</a> and review the{" "}
        <a href="/calculators/amortization-schedule-calculator">amortization schedule</a>.
      </p>
      <p class="muted" style="margin:10px 0 0">
        Questions or feedback: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Most active mortgage workflow</h2>
      <p class="muted" style="margin:10px 0 0">
        Popular questions include: "If I pay $300 extra on my mortgage, how much interest do I save?", "One extra payment per year",
        and "Biweekly payments vs extra principal". Use the tools below to compare the payoff date and total interest under consistent
        assumptions.
      </p>
      <div class="btn-row" style="margin-top:12px">
        <a class="btn btn-primary" href="/calculators/extra-payment-calculator">Extra payment calculator</a>
        <a class="btn" href="/calculators/biweekly-mortgage-payment-calculator">Biweekly payment</a>
        <a class="btn" href="/calculators/additional-principal-payment-calculator">Additional principal</a>
        <a class="btn" href="/calculators/mortgage-payment-calculator">Mortgage payment</a>
        <a class="btn" href="/calculators/amortization-schedule-calculator">Amortization schedule</a>
      </div>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">Deep guides worth reading first</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li>
          <a href="/guides/why-minimum-payments-take-so-long">Why minimum payments take so long</a>: see why balances stall when payments are close to interest.
        </li>
        <li>
          <a href="/guides/credit-card-payoff-strategy">Credit card payoff strategy</a>: choose between fixed payment, snowball, and avalanche.
        </li>
        <li>
          <a href="/guides/apr-vs-interest-rate">APR vs interest rate</a>: compare fees and rate without misleading shortcuts.
        </li>
        <li>
          <a href="/guides/extra-mortgage-payments">Extra mortgage payments</a>: how principal prepayments change amortization and
          interest.
        </li>
        <li>
          <a href="/guides/amortization-with-extra-payments">Amortization with extra payments</a>: what changes in the payment table.
        </li>
        <li>
          <a href="/guides/one-extra-mortgage-payment-per-year">One extra payment per year</a>: monthly vs annual approaches.
        </li>
        <li>
          <a href="/guides/biweekly-vs-extra-principal">Biweekly vs extra principal</a>: what to ask your lender and how to compare.
        </li>
        <li>
          <a href="/guides/refinance-break-even">Refinance break-even</a>: compare monthly savings to closing costs and your horizon.
        </li>
        <li>
          <a href="/guides/mortgage-recast-vs-extra-payments">Recast vs extra payments</a>: lower your required payment vs pay off
          sooner.
        </li>
      </ul>
    </div>
  </section>

  <section class="card section" style="margin-top:18px">
    <h2 style="margin:0 0 12px">All calculators</h2>
    <div class="grid">
      {all.map((t) => (
        <a class="card2 tool col-6" href={`/calculators/${t.slug}`}>
          <div class="tool-title">{t.title}</div>
          <div class="tool-desc">{t.description}</div>
          <div class="muted" style="font-size:12px; margin-top:4px">{t.category}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="card section" style="margin-top:18px">
    <h2 style="margin:0 0 12px">Guides</h2>
    <div class="grid">
      <a class="card2 tool col-6" href="/guides/apr-vs-interest-rate">
        <div class="tool-title">APR vs interest rate</div>
        <div class="tool-desc">What APR includes, how fees change comparisons, and when APR can mislead.</div>
      </a>
      <a class="card2 tool col-6" href="/guides/credit-card-payoff-strategy">
        <div class="tool-title">Credit card payoff strategy</div>
        <div class="tool-desc">Fixed vs minimum payments, payoff levers, and snowball vs avalanche.</div>
      </a>
      <a class="card2 tool col-6" href="/guides/extra-mortgage-payments">
        <div class="tool-title">Extra mortgage payments</div>
        <div class="tool-desc">How principal prepayments change amortization and total interest.</div>
      </a>
      <a class="card2 tool col-6" href="/guides/refinance-break-even">
        <div class="tool-title">Refinance break-even</div>
        <div class="tool-desc">Compare monthly savings to closing costs and your time horizon.</div>
      </a>
      <a class="card2 tool col-6" href="/guides/why-minimum-payments-take-so-long">
        <div class="tool-title">Why minimum payments take so long</div>
        <div class="tool-desc">See why balances can linger for years and what payment changes actually move the payoff date.</div>
      </a>
      <a class="card2 tool col-6" href="/guides/how-credit-card-interest-is-calculated">
        <div class="tool-title">How credit card interest is calculated</div>
        <div class="tool-desc">APR vs daily interest, statement timing, and why issuer math can differ from quick estimates.</div>
      </a>
      <a class="card2 tool col-6" href="/guides">
        <div class="tool-title">Browse all guides</div>
        <div class="tool-desc">Browse the full guide library after you have picked the right workflow.</div>
      </a>
    </div>
  </section>

  <section class="card section" style="margin-top:18px">
    <h2 style="margin:0 0 12px">Topics</h2>
    <div class="grid">
      <a class="card2 tool col-6" href="/topics/apr">
        <div class="tool-title">APR & borrowing costs</div>
        <div class="tool-desc">Compare offers with fees using the APR calculator and avoid common pitfalls.</div>
      </a>
      <a class="card2 tool col-6" href="/topics/credit-cards">
        <div class="tool-title">Credit cards & payoff</div>
        <div class="tool-desc">Use the credit card payoff calculator to model timelines and interest.</div>
      </a>
      <a class="card2 tool col-6" href="/topics/rent-vs-buy">
        <div class="tool-title">Rent vs buy</div>
        <div class="tool-desc">Compare housing scenarios with a break-even workflow and realistic assumptions.</div>
      </a>
      <a class="card2 tool col-6" href="/topics/mortgage-payoff">
        <div class="tool-title">Mortgage payoff planning</div>
        <div class="tool-desc">Run the mortgage payoff calculator to compare extra principal strategies.</div>
      </a>
      <a class="card2 tool col-6" href="/topics/debt-to-income">
        <div class="tool-title">Debt-to-income (DTI)</div>
        <div class="tool-desc">Estimate affordability using front-end and back-end ratios.</div>
      </a>
      <a class="card2 tool col-6" href="/topics/refinance">
        <div class="tool-title">Refinance decisions</div>
        <div class="tool-desc">Compare closing costs, payment changes, and break-even timing.</div>
      </a>
      <a class="card2 tool col-6" href="/topics">
        <div class="tool-title">Browse all topics</div>
        <div class="tool-desc">Workflow pages that connect calculators with the right guides.</div>
      </a>
    </div>
  </section>

  <section class="section">
    <AdSlot slot={slots.homeMid} minHeight={280} />
  </section>
</BaseLayout>
