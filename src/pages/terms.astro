---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewedByCard from "../components/ReviewedByCard.astro";
import TrustPolicyLinks from "../components/TrustPolicyLinks.astro";
import { SITE } from "../config/site";
import { TRUST_PROFILES } from "../config/trust";

const title = `Terms of Use | ${SITE.name}`;
const description =
  "Terms of use for Practical Finance Tools, including educational-use boundaries, calculator limitations, acceptable use, and service availability.";

const lastUpdated = "2026-06-24";
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/terms"
  lastUpdated={lastUpdated}
  authorProfile={TRUST_PROFILES.siteOwner}
  reviewProfiles={[TRUST_PROFILES.editorialReview, TRUST_PROFILES.methodologyReview]}
>
  <section class="card hero">
    <h1>Terms of Use</h1>
    <p>
      These terms explain how this site may be used, what the calculators are designed to do, and where the service
      boundaries stop.
    </p>
    <p class="muted">Last updated: 2026-06-24</p>
  </section>

  <ReviewedByCard
    writtenBy={TRUST_PROFILES.siteOwner}
    reviewedBy={TRUST_PROFILES.editorialReview}
    secondaryReview={TRUST_PROFILES.methodologyReview}
    reviewScope="Public-use boundaries, calculator limitations, service availability language, and acceptable-use expectations."
    reviewedOn="2026-06-24"
  />

  <TrustPolicyLinks currentPath="/terms" intro="These public documents explain how the site is maintained, how policies are reviewed, and what expectations apply when you use the calculators and guides." />

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">1. educational use only</h2>
    <p class="muted" style="margin:10px 0 0">
      The calculators, guides, and topic hubs on this site are provided for informational and educational use only. They
      do not provide personalized financial, legal, tax, or accounting advice, and using the site does not create a
      professional relationship.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">2. calculator limitations</h2>
    <p class="muted" style="margin:10px 0 0">
      Calculator results are estimates based on user inputs and the assumptions described on each page. Real lender,
      servicer, issuer, and tax outcomes can differ because of rounding, fee rules, statement timing, escrow treatment,
      underwriting, compounding, payment allocation, and policy differences.
    </p>
    <ul class="muted" style="margin:12px 0 0; padding-left:18px">
      <li>Use calculators to compare scenarios, not to replace payoff letters, disclosures, or account statements.</li>
      <li>Verify material decisions with the lender, issuer, servicer, or a licensed professional.</li>
      <li>Do not treat a single estimate as a guarantee of approval, monthly payment, or savings.</li>
    </ul>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">3. your responsibility to verify inputs</h2>
    <p class="muted" style="margin:10px 0 0">
      You are responsible for using current, accurate inputs and for reviewing the notes, assumptions, and methodology
      attached to the page you are using. If a statement, disclosure, or servicer rule conflicts with a site estimate,
      the official source controls.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">4. acceptable use</h2>
    <p class="muted" style="margin:10px 0 0">
      You agree not to misuse the site, interfere with operations, attempt to access non-public systems, or run automated
      requests that materially degrade service for others. Normal indexing by major search engines is not the target of
      this restriction; abusive scraping, credential attacks, and denial-of-service style behavior are.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">5. service availability</h2>
    <p class="muted" style="margin:10px 0 0">
      We aim to keep the site available and accurate, but we do not promise uninterrupted service availability. Pages,
      calculators, references, and features may be updated, removed, or temporarily unavailable as the site evolves.
    </p>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">6. third-party links and ads</h2>
      <p class="muted" style="margin:10px 0 0">
        The site may link to regulators, issuers, lenders, or other third-party sites and may display advertising. We do
        not control those third parties and are not responsible for their products, services, content, or policies.
      </p>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">7. ownership and feedback</h2>
      <p class="muted" style="margin:10px 0 0">
        Site content, code, design, and branding are owned by Practical Finance Tools or its licensors. If you send
        feedback or corrections, you give us permission to use that feedback to improve the site without compensation.
      </p>
    </div>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">8. no warranty</h2>
    <p class="muted" style="margin:10px 0 0">
      The site is provided on an "as is" and "as available" basis without warranties of any kind, including implied
      warranties of merchantability, fitness for a particular purpose, or non-infringement, to the extent allowed by law.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">9. limitation of liability</h2>
    <p class="muted" style="margin:10px 0 0">
      To the fullest extent permitted by law, we are not liable for losses or damages arising from your use of the site,
      reliance on site content, or inability to use the service.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">10. changes to these terms</h2>
    <p class="muted" style="margin:10px 0 0">
      We may revise these terms when the service, policies, or operational boundaries change. Continued use after an
      update means you accept the revised terms.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">11. contact</h2>
    <p class="muted" style="margin:10px 0 0">
      Questions about these terms can be sent to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </section>
</BaseLayout>
