---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config/site";
import { TOOLS } from "../../lib/tools";
import AdSlot from "../../components/AdSlot.astro";
import ReviewedByCard from "../../components/ReviewedByCard.astro";
import { TRUST_PROFILES } from "../../config/trust";

const title = `Calculators | ${SITE.name}`;
const description =
  "Choose the right calculator for APR, credit-card payoff, DTI, mortgage payment, rent vs buy, and extra-payment decisions. Educational use only.";

const grouped = TOOLS.reduce<Record<string, typeof TOOLS>>((acc, t) => {
  (acc[t.category] ||= []).push(t);
  return acc;
}, {});
const slots = SITE.adsenseSlots;
const lastUpdated = "2026-04-22";
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath="/calculators"
  lastUpdated={lastUpdated}
  authorProfile={TRUST_PROFILES.siteOwner}
  reviewProfiles={[TRUST_PROFILES.editorialReview, TRUST_PROFILES.methodologyReview]}
>
  <section class="card hero">
    <h1>Calculators: choose the right first model</h1>
    <p>
      Start with the question you are trying to answer. Calculator pages work best when the numeric job is already clear and you want the
      fastest path to a baseline estimate.
    </p>
    <p class="muted" style="margin:10px 0 0">I want to compare two loan offers. I want to know how long payoff will take on one balance. I want to know whether an extra mortgage payment is realistic. Those are three different calculator jobs, and they should not start on the same tool.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/calculators/apr-calculator">APR calculator</a>
      <a class="btn" href="/calculators/credit-card-payoff-calculator">Credit card payoff calculator</a>
      <a class="btn" href="/calculators/mortgage-payment-calculator">Mortgage payment calculator</a>
      <a class="btn" href="/calculators/debt-to-income-calculator">DTI calculator</a>
      <a class="btn" href="/calculators/rent-vs-buy-calculator">Rent vs buy calculator</a>
      <a class="btn" href="/calculators/extra-payment-calculator">Extra payment calculator</a>
    </div>
  </section>

  <ReviewedByCard
    writtenBy={TRUST_PROFILES.siteOwner}
    reviewedBy={TRUST_PROFILES.editorialReview}
    secondaryReview={TRUST_PROFILES.methodologyReview}
    reviewScope="Calculator-index routing, first-tool prioritization, and the editorial rules for when readers should stay in the calculator layer versus switch to a topic hub or guide."
    reviewedOn={lastUpdated}
  />

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Choose the calculator job before you choose the tool</h2>
    <p class="muted" style="margin:10px 0 0">
      The wrong calculator can produce a precise number for the wrong problem. Use the routing below to match the calculation job to the
      best first model.
    </p>
    <div style="overflow:auto; margin-top:12px">
      <table class="table">
        <thead>
          <tr>
            <th>Your calculator job</th>
            <th>Best first calculator</th>
            <th>Best next move</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>compare loan offers, fees, or borrowing cost</td>
            <td><a href="/calculators/apr-calculator">APR calculator</a></td>
            <td><a href="/topics/apr">APR topic</a> if you still need to sort out disclosures, fees, or time horizon.</td>
          </tr>
          <tr>
            <td>one balance payoff or fixed monthly target</td>
            <td><a href="/calculators/credit-card-payoff-calculator">Credit card payoff calculator</a></td>
            <td><a href="/guides/credit-card-payoff-strategy">Credit card payoff strategy</a> if the number needs interpretation.</td>
          </tr>
          <tr>
            <td>multiple balances and payoff order</td>
            <td>
              <a href="/calculators/debt-snowball-calculator">Debt snowball</a> and{" "}
              <a href="/calculators/debt-avalanche-calculator">debt avalanche</a>
            </td>
            <td><a href="/topics/credit-cards">Credit cards topic</a> if motivation versus interest-cost tradeoffs are still unclear.</td>
          </tr>
          <tr>
            <td>housing payment or affordability estimate</td>
            <td>
              <a href="/calculators/mortgage-payment-calculator">Mortgage payment calculator</a> or{" "}
              <a href="/calculators/debt-to-income-calculator">DTI calculator</a>
            </td>
            <td><a href="/topics/debt-to-income">DTI topic</a> when you still need to choose between payment, qualification, or DTI branches.</td>
          </tr>
          <tr>
            <td>rent-vs-buy scenario comparison</td>
            <td><a href="/calculators/rent-vs-buy-calculator">Rent vs buy calculator</a></td>
            <td><a href="/topics/rent-vs-buy">Rent vs buy topic</a> if the real blocker is break-even, costs, or assumption setup.</td>
          </tr>
          <tr>
            <td>extra principal or mortgage payoff acceleration</td>
            <td><a href="/calculators/extra-payment-calculator">Extra payment calculator</a></td>
            <td><a href="/topics/mortgage-payoff">Mortgage payoff topic</a> if you may need biweekly, lump sum, recast, or refinance alternatives.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="grid" style="margin-top:18px">
    <div class="card section prose col-6">
      <h2 style="margin-top:0">When calculators are the right layer</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li>Use a calculator when you already know the numeric question and need a baseline estimate fast.</li>
        <li>Run one clean baseline before changing assumptions like rate, fee, payment, or extra amount.</li>
        <li>Use real statement or disclosure numbers whenever possible.</li>
      </ul>
    </div>
    <div class="card section prose col-6">
      <h2 style="margin-top:0">When to switch to topics or guides</h2>
      <ul class="muted" style="margin:10px 0 0; padding-left:18px">
        <li>Use <a href="/topics">topics</a> when you do not yet know which sub-question owns the decision.</li>
        <li>Use <a href="/guides">guides</a> when the number is easy to compute but hard to interpret.</li>
        <li>If three calculators all seem plausible, step back to the topic hub before modeling more scenarios.</li>
      </ul>
    </div>
  </section>

  <section class="grid" style="margin-top:18px">
    <a class="card section prose col-6" href="/calculators/apr-calculator">
      <h2 style="margin-top:0">APR and offer-comparison path</h2>
      <p class="muted" style="margin:10px 0 0">
        Start here when the real question is total borrowing cost after fees, points, or lender credits.
      </p>
    </a>
    <a class="card section prose col-6" href="/calculators/credit-card-payoff-calculator">
      <h2 style="margin-top:0">One-balance payoff path</h2>
      <p class="muted" style="margin:10px 0 0">
        Start here when a fixed monthly payment, payoff date, or total interest estimate is the main job.
      </p>
    </a>
    <a class="card section prose col-6" href="/calculators/debt-snowball-calculator">
      <h2 style="margin-top:0">Multi-balance payoff-order path</h2>
      <p class="muted" style="margin:10px 0 0">
        Start here when the real question is motivation versus interest-cost tradeoff across multiple balances.
      </p>
    </a>
    <a class="card section prose col-6" href="/calculators/mortgage-payment-calculator">
      <h2 style="margin-top:0">Housing-payment and DTI path</h2>
      <p class="muted" style="margin:10px 0 0">
        Start here when the job is payment fit, affordability, or a fast mortgage-and-DTI baseline.
      </p>
    </a>
    <a class="card section prose col-6" href="/calculators/rent-vs-buy-calculator">
      <h2 style="margin-top:0">Rent-vs-buy path</h2>
      <p class="muted" style="margin:10px 0 0">
        Start here when hold period, upfront cash, and ownership-cost assumptions are driving the answer.
      </p>
    </a>
    <a class="card section prose col-6" href="/calculators/extra-payment-calculator">
      <h2 style="margin-top:0">Mortgage-payoff acceleration path</h2>
      <p class="muted" style="margin:10px 0 0">
        Start here when extra principal, payoff speed, and total-interest savings are the primary questions.
      </p>
    </a>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Browse the full calculator library</h2>
    <p class="muted" style="margin:10px 0 0">
      If the primary paths above are close but not exact, the full library is still available below as a secondary browse layer.
    </p>
  </section>

  <section style="margin-top:18px">
    {Object.entries(grouped).map(([category, tools]) => (
      <div style="margin-bottom:16px">
        <div class="pill" style="margin: 6px 0 10px">{category}</div>
        <div class="grid">
          {tools.map((t) => (
            <a class="card2 tool col-6" href={`/calculators/${t.slug}`}>
              <div class="tool-title">{t.title}</div>
              <div class="tool-desc">{t.description}</div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="section">
    <AdSlot slot={slots.calculatorsListMid} minHeight={280} />
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">FAQ</h2>
    <h3 style="margin:12px 0 0">Are these calculators free?</h3>
    <p class="muted" style="margin:8px 0 0">Yes. No account or signup is required.</p>
    <h3 style="margin:12px 0 0">Do you store my inputs?</h3>
    <p class="muted" style="margin:8px 0 0">
      Calculations run in your browser. See <a href="/privacy-policy">Privacy Policy</a> and <a href="/cookie-notice">Cookie Notice</a>.
    </p>
    <h3 style="margin:12px 0 0">Is this financial advice?</h3>
    <p class="muted" style="margin:8px 0 0">
      No. This site is for educational use only. Verify results with lenders, card issuers, and professionals.
    </p>
  </section>

  <section class="card section prose" style="margin-top:18px">
    <h2 style="margin-top:0">Updates</h2>
    <p class="muted" style="margin:10px 0 0">
      This routing page is updated when stronger first-tool paths are identified, calculator roles shift, or the topic-versus-tool boundary needs to be clarified.
    </p>
    <p class="muted" style="margin:12px 0 0; font-size:13px">Last updated: 2026-04-22</p>
  </section>
</BaseLayout>
