---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
import { DebtSnowballCalculator as DebtSnowballCalculatorComponent } from "../../components/calculators/DebtSnowball";
import ReviewedByCard from "../../components/ReviewedByCard.astro";
import { buildDebtPlan } from "../../lib/calc/debtPlan";

const title = "Debt Snowball Calculator";
const metaTitle = "Debt Snowball Calculator | Payoff Time and Interest";
const description =
  "Debt snowball calculator to estimate payoff time and total interest using the smallest-balance-first method. Educational use only.";

const exampleDebts = [
  { id: "card-a", name: "Card A", balance: 600, aprPercent: 24, minPayment: 25 },
  { id: "card-b", name: "Card B", balance: 2500, aprPercent: 18, minPayment: 70 },
  { id: "loan-c", name: "Loan C", balance: 8000, aprPercent: 8, minPayment: 160 }
];
const examplePlan = buildDebtPlan({ debts: exampleDebts, extraMonthly: 150, strategy: "snowball" });
const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", minimumFractionDigits: 2, maximumFractionDigits: 2 });
const caseOneDebts = [
  { id: "store-card", name: "Store Card", balance: 900, aprPercent: 29.99, minPayment: 40 },
  { id: "visa", name: "Visa", balance: 3800, aprPercent: 21.49, minPayment: 95 },
  { id: "personal-loan", name: "Personal Loan", balance: 6400, aprPercent: 11.2, minPayment: 170 }
];
const caseOnePlan = buildDebtPlan({ debts: caseOneDebts, extraMonthly: 220, strategy: "snowball" });
const caseOneTightCashflow = buildDebtPlan({ debts: caseOneDebts, extraMonthly: 120, strategy: "snowball" });
const caseOneMonthsFaster = Math.max(0, caseOneTightCashflow.months - caseOnePlan.months);
const caseOneInterestLower = Math.max(0, caseOneTightCashflow.totalInterest - caseOnePlan.totalInterest);
const caseTwoPromoDebts = [
  { id: "promo-card", name: "Promo Card", balance: 3400, aprPercent: 0, minPayment: 45 },
  { id: "travel-card", name: "Travel Card", balance: 2600, aprPercent: 23.99, minPayment: 75 },
  { id: "line-credit", name: "Line of Credit", balance: 5200, aprPercent: 9.8, minPayment: 130 }
];
const caseTwoPromoPlan = buildDebtPlan({ debts: caseTwoPromoDebts, extraMonthly: 180, strategy: "snowball" });
const caseTwoResetPlan = buildDebtPlan({
  debts: caseTwoPromoDebts.map((debt) =>
    debt.id === "promo-card" ? { ...debt, aprPercent: 27.99 } : debt
  ),
  extraMonthly: 180,
  strategy: "snowball"
});
const caseTwoResetMonthDiff = Math.max(0, caseTwoResetPlan.months - caseTwoPromoPlan.months);
const caseTwoResetInterestDiff = Math.max(0, caseTwoResetPlan.totalInterest - caseTwoPromoPlan.totalInterest);
---
<CalculatorLayout
  title={title}
  metaTitle={metaTitle}
  description={description}
  canonicalPath="/calculators/debt-snowball-calculator"
  intro="This debt snowball calculator estimates payoff timeline and interest when you pay minimums on every debt and target the smallest balance first. Educational use only. Not financial advice."
  how={[
    "Each month, interest is estimated as balance x (APR / 12).",
    "Minimum payments are applied to all debts; extra money is applied to the target debt (smallest balance).",
    "When a debt is paid off, its payment is freed up for other debts.",
    "Results assume APRs and minimum payments stay constant and you make on-time payments."
  ]}
  faqs={[
    {
      q: "What is the debt snowball method?",
      a: "A payoff strategy that prioritizes the smallest balance first to build momentum while still paying minimums on everything else."
    },
    {
      q: "Is snowball better than avalanche?",
      a: "Snowball can be easier to stick with because you get quick wins. Avalanche often minimizes total interest. The best method is the one you will follow consistently."
    },
    {
      q: "Does this assume fixed APRs and minimum payments?",
      a: "Yes. If APRs change, minimum payment rules change, or you miss payments, results can change."
    },
    {
      q: "Can I include 0% promo balances?",
      a: "Yes. Set APR to 0%. Be aware promo periods can end and minimum payment rules vary by issuer."
    },
    {
      q: "Does this include fees or new purchases?",
      a: "No. Late fees, annual fees, and new purchases are not included, and they can slow payoff."
    },
    {
      q: "What if I miss a payment?",
      a: "This assumes on-time payments. Missed payments and penalty APR can increase costs and payoff time."
    },
    {
      q: "Should I stop using credit cards while paying them off?",
      a: "New purchases can slow payoff and add complexity. Many people find it easier to pause new charges (or use cash/debit) while following a payoff plan."
    },
    {
      q: "Should I close accounts after paying them off?",
      a: "Closing accounts can affect your credit profile and may not be necessary. Consider factors like annual fees, spending habits, and credit utilization, and choose what you can sustain."
    }
  ]}
  lastUpdated="2026-03-03"
>
  <DebtSnowballCalculatorComponent client:load />
  <ReviewedByCard
    reviewedBy="Practical Finance Tools Editorial Team"
    reviewerRole="Content and methodology review"
    reviewedOn="2026-03-03"
  />

  <div class="prose" style="margin-top:16px">
    <h2 style="margin:0 0 10px">How to use this debt snowball calculator</h2>
    <p class="muted" style="margin:0">
      Enter each debt's balance, APR, and minimum payment. Then add an "extra payment" amount, the additional money you
      can put toward debt each month. The snowball method applies that extra amount to the smallest balance first to
      help you get early payoffs. If you also want to model a single card in isolation, compare with the{" "}
      <a href="/calculators/minimum-payment-payoff-calculator">credit card minimum payment calculator</a>.
    </p>

    <h2 style="margin:18px 0 10px">Example scenario</h2>
    <p class="muted" style="margin:0">
      Suppose you have three debts: (1) $600 at 24% APR with a $25 minimum, (2) $2,500 at 18% with a $70 minimum, and
      (3) $8,000 at 8% with a $160 minimum. If you can pay $150 extra each month, snowball targets the $600 balance
      first. After it's paid off, you roll its payment into the next smallest balance and repeat.
    </p>

    <h2 style="margin:18px 0 10px">Example output (estimate)</h2>
    <div style="overflow:auto">
      <table class="table">
        <thead>
          <tr>
            <th>Metric</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Total payoff time</td>
            <td>{examplePlan.months} months</td>
          </tr>
          <tr>
            <td>Total interest</td>
            <td>{money.format(examplePlan.totalInterest)}</td>
          </tr>
          <tr>
            <td>First payoff</td>
            <td>
              {examplePlan.payoffs[0]?.name ?? "Debt"} (month {examplePlan.payoffs[0]?.payoffMonth ?? "N/A"})
            </td>
          </tr>
          <tr>
            <td>Second payoff</td>
            <td>
              {examplePlan.payoffs[1]?.name ?? "Debt"} (month {examplePlan.payoffs[1]?.payoffMonth ?? "N/A"})
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 style="margin:18px 0 10px">Debt snowball calculator inputs to verify</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Balances are current and include any interest already posted.</li>
      <li>APR and minimum payments match your statement.</li>
      <li>Extra payment amount is realistic for your budget.</li>
      <li>New purchases and fees are excluded from this model.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Statement-to-input mapping</h2>
    <div style="overflow:auto">
      <table class="table">
        <thead>
          <tr>
            <th>Calculator input</th>
            <th>Where to get it</th>
            <th>Common mismatch</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Balance</td>
            <td>Latest statement balance for each account</td>
            <td>Using an old balance before recent payments post</td>
          </tr>
          <tr>
            <td>APR</td>
            <td>Statement APR for that balance type</td>
            <td>Using promo APR after promo period ends</td>
          </tr>
          <tr>
            <td>Minimum payment</td>
            <td>Statement minimum due</td>
            <td>Guessing a percent instead of using issuer minimum</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 style="margin:18px 0 10px">Match your statements</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Use the statement minimums for each account, not just a guessed percentage.</li>
      <li>Verify promo APR end dates and model the post-promo rate as a scenario.</li>
      <li>If a balance has multiple APRs (purchases vs cash advance), use the higher rate.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Boundary scenarios to test</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Promo APR ends in 3-6 months and resets to a higher standard APR.</li>
      <li>Minimum payment increases after a balance threshold is crossed.</li>
      <li>Two debts have similar balances: compare snowball tie-break vs avalanche.</li>
      <li>A small residual interest month appears after payoff ("trailing interest").</li>
    </ul>

    <h2 style="margin:18px 0 10px">Real-world case studies</h2>
    <div style="overflow:auto; margin-top:10px">
      <table class="table">
        <thead>
          <tr>
            <th>Case</th>
            <th>Input snapshot</th>
            <th>Result snapshot</th>
            <th>Decision note</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Three-debt household with stable APRs</td>
            <td>
              Debts: {money.format(900)}, {money.format(3800)}, {money.format(6400)}.
              Snowball extra payment: {money.format(220)} vs {money.format(120)}.
            </td>
            <td>
              Higher extra is {caseOneMonthsFaster} months faster and lowers interest by {money.format(caseOneInterestLower)}.
              First payoff: {caseOnePlan.payoffs[0]?.name ?? "Debt"} in month {caseOnePlan.payoffs[0]?.payoffMonth ?? "N/A"}.
            </td>
            <td>
              A sustainable extra payment matters more than perfect strategy details in early months.
            </td>
          </tr>
          <tr>
            <td>Promo APR reset stress test</td>
            <td>
              Same balances and minimums, extra {money.format(180)}. Base model keeps promo card at 0% APR; stress case resets promo card to 27.99%.
            </td>
            <td>
              Reset scenario extends payoff by {caseTwoResetMonthDiff} months and adds {money.format(caseTwoResetInterestDiff)} interest.
              Base payoff: {caseTwoPromoPlan.months} months; reset payoff: {caseTwoResetPlan.months} months.
            </td>
            <td>
              If a promo is ending soon, plan using the post-promo APR first to avoid underestimating payoff time.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin:12px 0 0">
      Boundary condition to test: run one scenario with minimum payments increased by 10%-15% to see if issuer rule changes materially shift payoff order.
    </p>

    <h2 style="margin:18px 0 10px">When snowball can be a fit</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>You want quick wins to stay motivated.</li>
      <li>Small balances can be closed quickly with focused payments.</li>
      <li>You value simplicity over absolute interest minimization.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Compare snowball vs avalanche</h2>
    <p class="muted" style="margin:0">
      Snowball targets the smallest balance first for momentum, while avalanche targets the highest APR to minimize interest.
      Run both plans to see which payoff timeline fits your goals.
    </p>
    <div class="btn-row" style="margin-top:10px">
      <a class="btn" href="/calculators/debt-avalanche-calculator">Debt avalanche calculator</a>
    </div>

    <h2 style="margin:18px 0 10px">Snowball debt calculator quick check</h2>
    <p class="muted" style="margin:0">
      If you search for a "snowball debt calculator", verify two things first: statement minimums are accurate and your extra
      payment is sustainable. Those two inputs drive most payoff-date differences.
    </p>

    <h2 style="margin:18px 0 10px">How to make the plan realistic</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Use the statement minimum payment (or required payment) so the schedule stays realistic.</li>
      <li>Start with an extra payment you can sustain, then increase it when you have proof it works.</li>
      <li>If you have promo APRs that will end, rerun the plan with the future APR as a scenario.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Common pitfalls</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Snowball may not minimize interest; it prioritizes motivation and simplicity over cost.</li>
      <li>APR and minimum payment rules can change (promo APR ends, penalty APR, issuer policy changes).</li>
      <li>Adding new purchases or fees can extend payoff time significantly.</li>
      <li>If your "extra payment" is not realistic, the plan may be hard to stick with; start conservative.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Assumptions & limitations</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>APRs and minimum payments are fixed unless you manually update them.</li>
      <li>No new purchases or fees are added during the payoff plan.</li>
      <li>Payments post on time each month without late fees or skipped payments.</li>
    </ul>

    <h2 style="margin:18px 0 10px">If results look off</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Verify each minimum payment matches your statement.</li>
      <li>Check for promo APRs that will end and model the future APR.</li>
      <li>Reduce the extra payment to an amount you can sustain.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Related guides</h2>
    <div class="btn-row" style="margin-top:0">
      <a class="btn btn-primary" href="/topics/credit-cards">Credit cards topic hub</a>
      <a class="btn" href="/guides/credit-card-payoff-strategy">Credit card payoff strategy</a>
      <a class="btn" href="/guides/debt-snowball-vs-avalanche">Debt snowball vs avalanche</a>
      <a class="btn" href="/guides/how-credit-card-interest-is-calculated">How credit card interest is calculated</a>
      <a class="btn" href="/guides/why-minimum-payments-take-so-long">Why minimum payments take so long</a>
    </div>

    <h2 style="margin:18px 0 10px">Related tools</h2>
    <div class="btn-row" style="margin-top:0">
      <a class="btn" href="/calculators/debt-avalanche-calculator">Debt avalanche (highest APR first)</a>
      <a class="btn" href="/calculators/credit-card-payoff-calculator">Credit card payoff</a>
      <a class="btn" href="/calculators/minimum-payment-payoff-calculator">Minimum payment payoff</a>
      <a class="btn" href="/calculators/apr-calculator">APR calculator</a>
    </div>

    <h2 style="margin:18px 0 10px">References</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>
        <a href="https://www.consumerfinance.gov/consumer-tools/debt-collection/" rel="noopener noreferrer">
          CFPB: Debt resources
        </a>
      </li>
      <li>
        <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-minimum-payment-en-23/" rel="noopener noreferrer">
          CFPB: Minimum payment basics
        </a>
      </li>
    </ul>
  </div>
</CalculatorLayout>

