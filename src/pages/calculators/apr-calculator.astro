---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
import { AprCalculator as AprCalculatorComponent } from "../../components/calculators/Apr";
import { estimateApr } from "../../lib/calc/apr";

const title = "APR Calculator";
const metaTitle = "APR Calculator | Estimate Annual APR from Rate and Fees";
const description =
  "APR calculator to estimate annual percentage rate from interest rate, upfront fees, and loan term so you can compare offers fairly. Educational use only.";

const exampleInput = { loanAmount: 10000, nominalRatePercent: 12, termMonths: 24, fees: 300 };
const example = estimateApr(exampleInput);
const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", minimumFractionDigits: 2, maximumFractionDigits: 2 });
const pct = new Intl.NumberFormat("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const num1 = new Intl.NumberFormat("en-US", { minimumFractionDigits: 0, maximumFractionDigits: 1 });
const examplePayment = money.format(example.payment);
const exampleApr = example.aprPercent == null ? "N/A" : `${pct.format(example.aprPercent)}%`;
const exampleSpread =
  example.aprPercent == null ? "N/A" : `${pct.format(example.aprPercent - exampleInput.nominalRatePercent)}%`;
const breakevenA = { loanAmount: 15000, nominalRatePercent: 10.5, termMonths: 36, fees: 0 };
const breakevenB = { loanAmount: 15000, nominalRatePercent: 9.75, termMonths: 36, fees: 450 };
const breakevenAResult = estimateApr(breakevenA);
const breakevenBResult = estimateApr(breakevenB);
const breakevenMonthlySavings = breakevenAResult.payment - breakevenBResult.payment;
const breakevenMonths =
  breakevenMonthlySavings > 0 ? breakevenB.fees / breakevenMonthlySavings : null;
---
<CalculatorLayout
  title={title}
  metaTitle={metaTitle}
  description={description}
  canonicalPath="/calculators/apr-calculator"
  intro="Use this APR calculator to estimate annual APR by combining interest rate, term, and upfront fees. This estimate helps you compare loan offers on a consistent basis. Educational use only, not an official lender disclosure."
  how={[
    "Monthly payment is calculated from the nominal rate and loan amount using standard amortization.",
    "APR is estimated by solving for the discount rate that makes the present value of payments equal to the net amount received (loan amount minus fees).",
    "This is a simplified estimate; lender APR disclosures follow specific regulatory rules and may treat fees differently."
  ]}
  faqs={[
    {
      q: "APR vs interest rate: what's the difference?",
      a: "Interest rate is the nominal rate used to compute interest. APR includes certain fees and can be higher than the interest rate."
    },
    {
      q: "How do I find out my APR?",
      a: "For credit cards, your APR is on your statement or cardmember agreement. For loans, lenders disclose APR in the Truth in Lending documents. This calculator estimates APR from rate, term, and upfront fees to compare scenarios."
    },
    {
      q: "How do I calculate APR with an origination fee?",
      a: "Treat the origination fee as reducing the amount you effectively receive. APR is the rate that makes the present value of your payments equal to (loan amount - fees)."
    },
    {
      q: "Can I calculate APR from a monthly payment?",
      a: "Sometimes. If you know the loan amount, term, and fees, the payment can imply an APR. This calculator estimates APR under a simplified schedule; real disclosures can differ."
    },
    {
      q: "Which fees should I include?",
      a: "Include upfront fees that reduce what you effectively receive (e.g., origination fees). Product-specific rules vary, so use this as a comparison tool."
    },
    {
      q: "Does APR predict the total amount paid?",
      a: "It helps compare cost across offers, but total paid also depends on term, payment schedule, and whether you prepay or refinance."
    },
    {
      q: "What if my APR is extremely high?",
      a: "Very high APRs can make the payment mostly interest early on. Use APR to compare offers, but also review total interest paid and whether fees are avoidable."
    },
    {
      q: "Can APR change over time?",
      a: "For variable-rate products it can. This calculator assumes a fixed payment based on the nominal rate provided."
    },
    {
      q: "Is this an official APR disclosure?",
      a: "No. It's an educational estimate to compare scenarios. Official APR disclosures follow specific legal rules."
    }
  ]}
  lastUpdated="2026-03-01"
>
  <AprCalculatorComponent client:load />

  <div class="prose" style="margin-top:16px">
    <h2 style="margin:0 0 10px">Quick takeaways</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>APR can be higher than the interest rate when there are upfront fees.</li>
      <li>Compare offers using the same term and assumptions.</li>
      <li>If you refinance or prepay early, the lowest-APR offer may not be the cheapest for you.</li>
    </ul>

    <h2 style="margin:18px 0 10px">APR in one equation (conceptual)</h2>
    <p class="muted" style="margin:0 0 10px">
      APR is the rate that makes the present value of the payment stream equal to the cash you actually receive. A simplified monthly
      model looks like this:
    </p>
    <pre style="margin:0 0 10px"><code>Sum from t=1..n of Payment / (1 + r)^t = Loan Amount - Upfront Fees
APR (annualized) approx = r * 12</code></pre>
    <p class="muted" style="margin:0">
      This calculator estimates APR using a standard fixed-rate payment schedule. Official disclosures follow specific rules for which
      fees are included and how timing is treated.
    </p>

    <h2 style="margin:0 0 10px">Example</h2>
    <p class="muted" style="margin:0">
      If two loans have the same nominal rate but one has higher upfront fees, the loan with higher fees can have a
      higher APR. Use this page to compare offers on a consistent term and payment schedule.
    </p>

    <h2 style="margin:18px 0 10px">Monthly rate to annual APR quick check</h2>
    <p class="muted" style="margin:0">
      If you search "what is annual APR with 0.61 monthly rate", a quick nominal estimate is <strong>0.61% x 12 = 7.32%</strong>.
      With monthly compounding, the effective annual rate is about <strong>7.57%</strong>. When upfront fees exist, use this
      calculator because fees can push APR above both quick conversions.
    </p>

    <h2 style="margin:18px 0 10px">Common fees that affect APR</h2>
    <div style="overflow:auto">
      <table class="table">
        <thead>
          <tr>
            <th>Fee type</th>
            <th>How it shows up</th>
            <th>Why it matters</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Origination fee</td>
            <td>Percent of loan or flat amount</td>
            <td>Reduces the net amount you receive, which can raise APR.</td>
          </tr>
          <tr>
            <td>Discount points</td>
            <td>Upfront points to lower rate</td>
            <td>Can lower the rate but raise upfront cost; APR helps compare on the same term.</td>
          </tr>
          <tr>
            <td>Financed fees</td>
            <td>Added to the balance</td>
            <td>Increases the amount you repay, changing the true cost.</td>
          </tr>
          <tr>
            <td>Third-party closing costs</td>
            <td>Appraisal, title, recording</td>
            <td>Often not included in APR; still part of your cash-to-close.</td>
          </tr>
          <tr>
            <td>Taxes, insurance, escrow</td>
            <td>Ongoing housing costs</td>
            <td>Not part of APR, but essential for affordability.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 style="margin:18px 0 10px">Step-by-step example</h2>
    <p class="muted" style="margin:0">
      Example: $10,000 loan, 12% interest rate, 24-month term, $300 origination fee.
    </p>
    <div style="overflow:auto; margin-top:10px">
      <table class="table">
        <thead>
          <tr>
            <th>Input</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Loan amount</td>
            <td>${money.format(exampleInput.loanAmount)}</td>
          </tr>
          <tr>
            <td>Nominal rate</td>
            <td>{exampleInput.nominalRatePercent}%</td>
          </tr>
          <tr>
            <td>Term</td>
            <td>{exampleInput.termMonths} months</td>
          </tr>
          <tr>
            <td>Upfront fees</td>
            <td>${money.format(exampleInput.fees)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div style="overflow:auto; margin-top:10px">
      <table class="table">
        <thead>
          <tr>
            <th>Output (estimate)</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Monthly payment (principal &amp; interest)</td>
            <td>{examplePayment}</td>
          </tr>
          <tr>
            <td>Estimated APR</td>
            <td>{exampleApr}</td>
          </tr>
          <tr>
            <td>APR minus rate (spread)</td>
            <td>{exampleSpread}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin:12px 0 0">
      Interpretation: the payment is based on the nominal rate and term. The APR rises because fees reduce the net amount you receive,
      so the effective cost is higher than the rate line suggests.
    </p>

    <h2 style="margin:18px 0 10px">Break-even quick check (fees vs lower rate)</h2>
    <p class="muted" style="margin:0 0 10px">
      If a lower rate requires fees, estimate how long it takes for monthly savings to offset those fees. This is a quick sanity check,
      not a substitute for full disclosures.
    </p>
    <div style="overflow:auto; margin-top:10px">
      <table class="table">
        <thead>
          <tr>
            <th>Scenario</th>
            <th class="num">Rate</th>
            <th class="num">Fees</th>
            <th class="num">Payment</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Offer A</td>
            <td class="num">{pct.format(breakevenA.nominalRatePercent)}%</td>
            <td class="num">{money.format(breakevenA.fees)}</td>
            <td class="num">{money.format(breakevenAResult.payment)}</td>
          </tr>
          <tr>
            <td>Offer B</td>
            <td class="num">{pct.format(breakevenB.nominalRatePercent)}%</td>
            <td class="num">{money.format(breakevenB.fees)}</td>
            <td class="num">{money.format(breakevenBResult.payment)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin:12px 0 0">
      Monthly savings is about {money.format(Math.max(0, breakevenMonthlySavings))}. Break-even is
      {breakevenMonths == null ? "N/A" : `${num1.format(breakevenMonths)} months`}. If you expect to pay off or refinance sooner than the
      break-even window, the lower-rate offer may not be cheaper for you.
    </p>

    <h2 style="margin:18px 0 10px">Disclosure-to-input mapping</h2>
    <div style="overflow:auto">
      <table class="table">
        <thead>
          <tr>
            <th>Calculator input</th>
            <th>Where to verify</th>
            <th>Common mismatch</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Loan amount</td>
            <td>Loan Estimate / offer sheet principal amount</td>
            <td>Using financed-fee amount as principal</td>
          </tr>
          <tr>
            <td>Nominal rate</td>
            <td>Interest rate line in disclosure</td>
            <td>Mixing teaser rate with full-rate scenario</td>
          </tr>
          <tr>
            <td>Term</td>
            <td>Payment schedule (months)</td>
            <td>Comparing different terms and treating APR as equivalent</td>
          </tr>
          <tr>
            <td>Upfront fees</td>
            <td>Origination/points in closing details</td>
            <td>Ignoring fees paid outside principal</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 style="margin:18px 0 10px">APR calculator assumptions & limitations</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>This is a simplified fixed-rate estimate using a standard monthly payment schedule.</li>
      <li>We treat fees as reducing the net amount received; lender disclosures can categorize fees differently.</li>
      <li>If you plan to refinance or repay early, compare total cost over your expected time horizon.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Boundary scenarios to run</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Same rate, higher fee to confirm APR rises as expected.</li>
      <li>Lower rate with points to test break-even horizon sensitivity.</li>
      <li>Short horizon (24-36 months) versus full-term hold.</li>
      <li>Fees paid cash vs financed to compare true cash burden.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Common pitfalls</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>APR is a comparison metric; it does not always match your total interest paid.</li>
      <li>Some fees may be paid out-of-pocket vs financed; your cash-to-close can differ even if APR is similar.</li>
      <li>Official lender APR disclosures can treat fees and timing differently than simplified calculators.</li>
      <li>If you expect to prepay or refinance, APR may not capture the full picture for your situation.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Match your disclosure</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Compare to the APR in your Loan Estimate or cardmember agreement, not the interest rate line.</li>
      <li>Check whether fees are financed or paid upfront; APR changes based on net amount received.</li>
      <li>Align the term and payment schedule to the disclosure (monthly vs other).</li>
    </ul>

    <h2 style="margin:18px 0 10px">Related guide</h2>
    <div class="btn-row" style="margin-top:0">
      <a class="btn btn-primary" href="/topics/apr">APR topic hub</a>
      <a class="btn" href="/guides/apr-vs-interest-rate">APR vs interest rate</a>
      <a class="btn" href="/guides/apr-vs-apy-loans">APR vs APY for loans</a>
      <a class="btn" href="/guides/apr-with-origination-fee">APR with origination fee</a>
      <a class="btn" href="/guides/how-to-find-your-apr">How to find your APR</a>
    </div>

    <h2 style="margin:18px 0 10px">Related tools</h2>
    <div class="btn-row" style="margin-top:0">
      <a class="btn" href="/calculators/mortgage-payment-calculator">Mortgage payment</a>
      <a class="btn" href="/calculators/amortization-schedule-calculator">Amortization schedule</a>
      <a class="btn" href="/calculators/debt-to-income-calculator">DTI calculator</a>
      <a class="btn" href="/calculators/credit-card-payoff-calculator">Credit card payoff</a>
    </div>

    <h2 style="margin:18px 0 10px">References</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li><a href="https://www.consumerfinance.gov/ask-cfpb/what-is-apr-en-17/" rel="noopener noreferrer">CFPB: What is APR?</a></li>
      <li>
        <a href="https://www.ecfr.gov/current/title-12/chapter-I/part-1026" rel="noopener noreferrer">
          Regulation Z (Truth in Lending)
        </a>
      </li>
    </ul>
  </div>
</CalculatorLayout>
