---
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
import { MinimumPaymentPayoff } from "../../components/calculators/MinimumPaymentPayoff";
import ReviewedByCard from "../../components/ReviewedByCard.astro";
import { TRUST_PROFILES } from "../../config/trust";
import { minimumPaymentPayoffSchedule, paymentToPayoffInMonths } from "../../lib/calc/creditCard";

const title = "Credit Card Minimum Payment Calculator";
const metaTitle = "Credit Card Minimum Payment Calculator | Payoff Time and Interest";
const description =
  "Credit card minimum payment calculator to estimate payoff time, total interest, and total cost when you make only minimum payments. Educational use only.";

const exampleInput = { balance: 5000, aprPercent: 24.99, minPercent: 2, minDollars: 25 };
const example = minimumPaymentPayoffSchedule(exampleInput);
const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", minimumFractionDigits: 2, maximumFractionDigits: 2 });
const money0 = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", minimumFractionDigits: 0, maximumFractionDigits: 0 });
const pct2 = new Intl.NumberFormat("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const exampleMonthlyInterest = exampleInput.balance * (exampleInput.aprPercent / 100 / 12);
const fixedPaymentA = 125;
const fixedPaymentB = 200;
const fixedPaymentC = 300;
const fixedA = minimumPaymentPayoffSchedule({ ...exampleInput, minPercent: 0, minDollars: fixedPaymentA });
const fixedB = minimumPaymentPayoffSchedule({ ...exampleInput, minPercent: 0, minDollars: fixedPaymentB });
const fixedC = minimumPaymentPayoffSchedule({ ...exampleInput, minPercent: 0, minDollars: fixedPaymentC });
const payoffTarget24 = paymentToPayoffInMonths({ balance: exampleInput.balance, aprPercent: exampleInput.aprPercent, targetMonths: 24 });
const payoffTarget36 = paymentToPayoffInMonths({ balance: exampleInput.balance, aprPercent: exampleInput.aprPercent, targetMonths: 36 });
const payoffTarget48 = paymentToPayoffInMonths({ balance: exampleInput.balance, aprPercent: exampleInput.aprPercent, targetMonths: 48 });
const caseOneInput = { balance: 7800, aprPercent: 26.99, minPercent: 2, minDollars: 35 };
const caseOneMinimumOnly = minimumPaymentPayoffSchedule(caseOneInput);
const caseOneBoosted = minimumPaymentPayoffSchedule({
  ...caseOneInput,
  minPercent: 0,
  minDollars: 190
});
const caseOneMinimumOnlyMonths = caseOneMinimumOnly.months ?? caseOneMinimumOnly.rows.length;
const caseOneBoostedMonths = caseOneBoosted.months ?? caseOneBoosted.rows.length;
const caseOneMonthsSaved = Math.max(0, caseOneMinimumOnlyMonths - caseOneBoostedMonths);
const caseOneInterestSaved = Math.max(0, caseOneMinimumOnly.totalInterest - caseOneBoosted.totalInterest);
const caseTwoBaseInput = { balance: 4200, aprPercent: 18.99, minPercent: 1, minDollars: 40 };
const caseTwoBase = minimumPaymentPayoffSchedule(caseTwoBaseInput);
const caseTwoReset = minimumPaymentPayoffSchedule({
  ...caseTwoBaseInput,
  aprPercent: 29.99
});
const caseTwoBaseMonths = caseTwoBase.months ?? caseTwoBase.rows.length;
const caseTwoResetMonths = caseTwoReset.months ?? caseTwoReset.rows.length;
const caseTwoMonthDelta = Math.max(0, caseTwoResetMonths - caseTwoBaseMonths);
const caseTwoInterestDelta = Math.max(0, caseTwoReset.totalInterest - caseTwoBase.totalInterest);
const caseTwoFirstMonthInterestBase = caseTwoBaseInput.balance * (caseTwoBaseInput.aprPercent / 100 / 12);
const caseTwoFirstMonthInterestReset = caseTwoBaseInput.balance * (29.99 / 100 / 12);
---
<CalculatorLayout
  title={title}
  metaTitle={metaTitle}
  description={description}
  canonicalPath="/calculators/minimum-payment-payoff-calculator"
  intro="This credit card minimum payment calculator estimates payoff time and total interest when you only make minimum payments. Educational use only. Not financial advice."
  how={[
    "Monthly interest is estimated as balance x (APR / 12).",
    "Minimum payment is estimated as max($ minimum, % of balance) using a simplified common rule.",
    "Estimates assume no new purchases are added and APR stays constant."
  ]}
  faqs={[
    {
      q: "Do issuers calculate minimum payments differently?",
      a: "Yes. Many issuers use tiered rules and include fees/interest differently. This calculator uses a simplified common rule to estimate payoff."
    },
    {
      q: "Why can minimum payments take so long?",
      a: "Minimum payments can be a small fraction of your balance, so principal reduction is slow while interest keeps accruing."
    },
    {
      q: "What happens if my minimum is close to interest?",
      a: "Progress can be extremely slow. Increasing your payment even a little can shorten payoff time substantially."
    },
    {
      q: "Does this include new purchases?",
      a: "No. This assumes no new charges are added to the balance."
    },
    {
      q: "Does this include fees?",
      a: "No. Late fees, annual fees, and other fees are not included. Fees can meaningfully increase total cost."
    },
    {
      q: "How can I reduce total interest?",
      a: "Pay more than the minimum, reduce APR (e.g., refinance/transfer), and prioritize higher-APR balances first."
    }
  ]}
  lastUpdated="2026-05-29"
  authorProfile={TRUST_PROFILES.siteOwner}
  reviewProfiles={[TRUST_PROFILES.methodologyReview, TRUST_PROFILES.editorialReview]}
>
  <MinimumPaymentPayoff client:load />
  <ReviewedByCard
    writtenBy={TRUST_PROFILES.siteOwner}
    reviewedBy={TRUST_PROFILES.methodologyReview}
    secondaryReview={TRUST_PROFILES.editorialReview}
    reviewScope="Minimum-payment modeling, statement-style assumptions, and risk framing for slow payoff paths."
    reviewedOn="2026-05-29"
  />

  <div class="prose" style="margin-top:16px">
    <h2 style="margin:0 0 10px">Use this calculator when the statement minimum is the number driving your plan</h2>
    <p class="muted" style="margin:0">
      This credit card minimum payment calculator is for the moment when the minimum due on your statement is still the number driving your plan.
      Use this page to see how long minimum-only payments can take, how much interest they can create, and what kind of fixed payment would
      produce a more realistic payoff window.
    </p>
    <p class="muted" style="margin:12px 0 0">
      In other words, this is the page to use when the statement minimum is the main input and you need to turn that minimum into a more
      realistic payoff decision.
    </p>
    <p class="muted" style="margin:12px 0 0">
      If your real problem is why the statement interest charge looks wrong, start with the <a href="/guides/how-credit-card-interest-is-calculated">interest explainer</a>.
      If you already know the payment you can commit to each month, go straight to the fixed-payment payoff calculator.
    </p>

    <h2 style="margin:18px 0 10px">Read these 3 numbers first</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li><strong>Estimated payoff time:</strong> how long the balance can last if you keep following the minimum rule.</li>
      <li><strong>Estimated total interest:</strong> the cost of letting the balance stay around for that long.</li>
      <li><strong>Minimum payment to avoid growth:</strong> the rough threshold below which the balance can start moving the wrong way.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Choose the question behind the minimum-payment problem</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>I need to see why the minimum barely moves the balance: stay on this page and compare first-month interest with the modeled minimum.</li>
      <li>I already know the fixed payment I want to make: switch to the <a href="/calculators/credit-card-payoff-calculator">credit card payoff calculator</a>.</li>
      <li>I need a strategy for multiple balances, not one card: move next to <a href="/calculators/debt-snowball-calculator">snowball</a> or <a href="/calculators/debt-avalanche-calculator">avalanche</a>.</li>
    </ul>

    <h2 style="margin:0 0 10px">Minimum payment formula (simplified)</h2>
    <p class="muted" style="margin:0 0 10px">
      Many issuers use a rule like:
    </p>
    <pre style="margin:0 0 10px"><code>Minimum payment = max(dollar floor, percent of balance)
Some issuers add interest and fees to that amount</code></pre>
    <p class="muted" style="margin:0">
      This calculator models the common percent-of-balance + dollar floor rule. Check your statement for the exact formula.
    </p>

    <h2 style="margin:18px 0 10px">Minimum payment calculation quick example</h2>
    <p class="muted" style="margin:0">
      If your issuer uses 2% of balance with a $25 floor, a $5,000 balance implies a minimum payment calculation of
      max($25, $100) = $100 before any issuer-specific adjustments for fees or interest treatment.
    </p>

    <h2 style="margin:0 0 10px">Example</h2>
    <p class="muted" style="margin:0">
      Try a $5,000 balance at 24.99% APR. Compare minimum payments only versus paying an extra $25-$100 per month.
      Many people are surprised by how much time and interest minimum-only payments can add.
    </p>

    <h2 style="margin:18px 0 10px">Example output (estimate)</h2>
    <p class="muted" style="margin:0">
      Example inputs: {money.format(exampleInput.balance)} balance, {exampleInput.aprPercent}% APR, minimum = {exampleInput.minPercent}% or
      {money.format(exampleInput.minDollars)}.
    </p>
    <div style="overflow:auto; margin-top:10px">
      <table class="table">
        <thead>
          <tr>
            <th>Metric</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Payoff time</td>
            <td>{example.months} months</td>
          </tr>
          <tr>
            <td>Total interest</td>
            <td>{money.format(example.totalInterest)}</td>
          </tr>
          <tr>
            <td>Total paid</td>
            <td>{money.format(example.totalPaid)}</td>
          </tr>
          <tr>
            <td>Min payment to avoid growth (approx.)</td>
            <td>{money.format(example.minPaymentToAvoidGrowth)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin:12px 0 0">
      First-month interest estimate is about {money.format(exampleMonthlyInterest)}. If the minimum payment is close to this number,
      principal reduction is tiny.
    </p>

    <h2 style="margin:18px 0 10px">Minimum due vs real payoff plan</h2>
    <p class="muted" style="margin:0">
      Minimum payments help avoid delinquency, but they are rarely the same thing as a reasonable payoff plan. For the same example
      balance and APR, here is how the statement minimum compares with a few fixed-payoff targets.
    </p>
    <div style="overflow:auto; margin-top:10px">
      <table class="table">
        <thead>
          <tr>
            <th>Payment plan</th>
            <th class="num">Approx. monthly payment</th>
            <th>What it means</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Statement minimum rule</td>
            <td class="num">{money.format(Math.max(exampleInput.minDollars, exampleInput.balance * (exampleInput.minPercent / 100)))}</td>
            <td>Variable payment that can keep dropping as the balance falls.</td>
          </tr>
          <tr>
            <td>48-month payoff target</td>
            <td class="num">{payoffTarget48 == null ? "N/A" : money.format(payoffTarget48)}</td>
            <td>Useful if you need a slower but still defined payoff window.</td>
          </tr>
          <tr>
            <td>36-month payoff target</td>
            <td class="num">{payoffTarget36 == null ? "N/A" : money.format(payoffTarget36)}</td>
            <td>Common middle ground between cash-flow flexibility and interest control.</td>
          </tr>
          <tr>
            <td>24-month payoff target</td>
            <td class="num">{payoffTarget24 == null ? "N/A" : money.format(payoffTarget24)}</td>
            <td>More aggressive, but usually cuts interest much faster.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 style="margin:18px 0 10px">Credit card minimum payment calculator inputs</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>APR: use the rate from your statement (not a promo teaser rate).</li>
      <li>Minimum payment rule: some issuers use % of balance plus interest/fees.</li>
      <li>New purchases: this tool assumes none; new charges can extend payoff.</li>
      <li>Statement timing: real statements may differ due to daily interest and cycles.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Pick a target payment, not just a minimum due</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Set a payoff window first, such as 24, 36, or 48 months, then back into a payment target.</li>
      <li>Use the total interest estimate to compare the cost of waiting versus the cash-flow pressure of paying faster.</li>
      <li>If a balance is barely shrinking, increase the payment above the monthly interest amount and re-run the plan.</li>
      <li>If you have multiple debts, use the <a href="/calculators/debt-snowball-calculator">debt snowball calculator</a> or <a href="/calculators/debt-avalanche-calculator">debt avalanche calculator</a> after setting a realistic payment level for each card.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Issuer minimum-rule comparison</h2>
    <div style="overflow:auto">
      <table class="table">
        <thead>
          <tr>
            <th>Rule pattern</th>
            <th>How to model here</th>
            <th>Why it matters</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>max(floor, % of balance)</td>
            <td>Use both percent and floor inputs</td>
            <td>Most common baseline for planning</td>
          </tr>
          <tr>
            <td>Interest + fees + small principal</td>
            <td>Increase percent input until first-month minimum matches statement</td>
            <td>Can materially increase total paid</td>
          </tr>
          <tr>
            <td>Tiered percentage by balance range</td>
            <td>Re-check inputs as balance declines</td>
            <td>Minimum payment may fall faster than expected</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2 style="margin:18px 0 10px">How to match your statement minimum</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Check the APR shown on the statement, not a marketing teaser or old promo rate.</li>
      <li>Use the statement minimum as a reality check against the calculator output.</li>
      <li>Confirm whether your issuer uses a percent rule, dollar floor, or a tiered schedule by balance range.</li>
      <li>If the statement includes interest and fees in the minimum, raise the percent input until the first-month minimum matches.</li>
      <li>Re-check after the next statement cycle to confirm the rule you are modeling.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Compare to a fixed-payment plan</h2>
    <p class="muted" style="margin:0">
      Minimum payment rules change with the balance. If you want a predictable payoff timeline, compare the same balance in the{" "}
      <a href="/calculators/credit-card-payoff-calculator">Credit Card Payoff Calculator</a> using a fixed monthly payment.
    </p>

    <h2 style="margin:18px 0 10px">Fixed payment comparison (same balance, same APR)</h2>
    <p class="muted" style="margin:0">
      If you can commit to a fixed payment, payoff time becomes more predictable. Here is a quick comparison using the same balance and APR:
    </p>
    <div style="overflow:auto; margin-top:10px">
      <table class="table">
        <thead>
          <tr>
            <th class="num">Payment</th>
            <th class="num">Payoff time</th>
            <th class="num">Total interest</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="num">{money0.format(fixedPaymentA)}</td>
            <td class="num">{fixedA.months == null ? "N/A" : `${fixedA.months} months`}</td>
            <td class="num">{money.format(fixedA.totalInterest)}</td>
          </tr>
          <tr>
            <td class="num">{money0.format(fixedPaymentB)}</td>
            <td class="num">{fixedB.months == null ? "N/A" : `${fixedB.months} months`}</td>
            <td class="num">{money.format(fixedB.totalInterest)}</td>
          </tr>
          <tr>
            <td class="num">{money0.format(fixedPaymentC)}</td>
            <td class="num">{fixedC.months == null ? "N/A" : `${fixedC.months} months`}</td>
            <td class="num">{money.format(fixedC.totalInterest)}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin:12px 0 0">
      Use this table to move from "what is my minimum due?" to "what payment actually fits my payoff target?"
    </p>

    <h2 style="margin:18px 0 10px">Real-world case studies</h2>
    <div style="overflow:auto; margin-top:10px">
      <table class="table">
        <thead>
          <tr>
            <th>Case</th>
            <th>Input snapshot</th>
            <th>Result snapshot</th>
            <th>Decision note</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Minimum-only vs fixed boosted payment</td>
            <td>
              {money.format(caseOneInput.balance)} at {pct2.format(caseOneInput.aprPercent)}% APR.
              Minimum rule {caseOneInput.minPercent}% or {money.format(caseOneInput.minDollars)}; boosted plan uses fixed {money.format(190)}.
            </td>
            <td>
              Boosted payment shortens payoff by {caseOneMonthsSaved} months and cuts interest by {money.format(caseOneInterestSaved)}.
            </td>
            <td>
              A fixed payment target can convert an open-ended minimum cycle into a predictable payoff window.
            </td>
          </tr>
          <tr>
            <td>APR reset stress test</td>
            <td>
              {money.format(caseTwoBaseInput.balance)} with minimum rule {caseTwoBaseInput.minPercent}% or {money.format(caseTwoBaseInput.minDollars)}.
              Compare APR {pct2.format(caseTwoBaseInput.aprPercent)}% vs {pct2.format(29.99)}%.
            </td>
            <td>
              First-month interest rises from {money.format(caseTwoFirstMonthInterestBase)} to {money.format(caseTwoFirstMonthInterestReset)}.
              Payoff extends by {caseTwoMonthDelta} months with {money.format(caseTwoInterestDelta)} more interest.
            </td>
            <td>
              If promo APR may end, model the reset rate now and set payment based on the stressed case.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="margin:12px 0 0">
      Boundary condition to test: when minimum payment is near monthly interest, add a late-fee month in your own plan assumptions and re-check payoff drift.
    </p>

    <h2 style="margin:18px 0 10px">Common pitfalls</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Issuers often use daily interest and statement cycles; monthly estimates can differ from your statement.</li>
      <li>Minimum payment rules vary by issuer and can change over time.</li>
      <li>New purchases, late fees, and penalty APR can extend payoff dramatically.</li>
      <li>If you're carrying multiple balances, prioritization (snowball/avalanche) can matter more than minimum rules.</li>
    </ul>

    <h2 style="margin:18px 0 10px">What should you do next?</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>If your issue is statement math, go to <a href="/guides/how-credit-card-interest-is-calculated">how credit card interest is calculated</a>.</li>
      <li>If you already know the fixed monthly amount you can sustain, move to the <a href="/calculators/credit-card-payoff-calculator">credit card payoff calculator</a>.</li>
      <li>If you need a multi-card order, move next to <a href="/calculators/debt-snowball-calculator">debt snowball</a> or <a href="/calculators/debt-avalanche-calculator">debt avalanche</a>.</li>
    </ul>

    <h2 style="margin:18px 0 10px">Boundary tests that catch bad assumptions</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>Minimum payment is very close to monthly interest (balance may barely drop).</li>
      <li>APR changes after promo expiry and minimum rule also changes.</li>
      <li>Balance approaches the dollar floor where percent rule stops driving the minimum.</li>
      <li>A single late fee month pushes minimum and timeline off-plan.</li>
    </ul>

    <h2 style="margin:18px 0 10px">What this calculator should send you to next</h2>
    <p class="muted" style="margin:0">
      This page should tell you whether the next move is understanding the drag, choosing a fixed payment target, or building a multi-card
      payoff order. Once you know which of those three problems you actually have, move to the narrower page that solves it.
    </p>

    <h2 style="margin:18px 0 10px">Related tools</h2>
    <div class="btn-row" style="margin-top:0">
      <a class="btn" href="/calculators/credit-card-payoff-calculator">Credit card payoff</a>
      <a class="btn" href="/calculators/debt-snowball-calculator">Debt snowball plan</a>
      <a class="btn" href="/calculators/debt-avalanche-calculator">Debt avalanche plan</a>
      <a class="btn" href="/calculators/apr-calculator">APR calculator</a>
    </div>

    <h2 style="margin:18px 0 10px">Related guide</h2>
    <div class="btn-row" style="margin-top:0">
      <a class="btn btn-primary" href="/topics/credit-cards">Credit cards topic hub</a>
      <a class="btn" href="/guides/why-minimum-payments-take-so-long">Why minimum payments take so long</a>
      <a class="btn" href="/guides/credit-card-payoff-strategy">Credit card payoff strategy</a>
      <a class="btn" href="/guides/how-credit-card-interest-is-calculated">How credit card interest works</a>
    </div>

    <h2 style="margin:18px 0 10px">References</h2>
    <ul class="muted" style="margin:0; padding-left:18px">
      <li>
        <a href="https://www.consumerfinance.gov/ask-cfpb/what-is-a-minimum-payment-en-23/" rel="noopener noreferrer">
          CFPB: What is a minimum payment?
        </a>
      </li>
      <li>
        <a href="https://www.consumerfinance.gov/ask-cfpb/how-is-interest-calculated-on-a-credit-card-en-71/" rel="noopener noreferrer">
          CFPB: How is interest calculated on a credit card?
        </a>
      </li>
    </ul>
    <p class="muted" style="margin:18px 0 0; font-size:13px">Last updated: 2026-05-29</p>
  </div>
</CalculatorLayout>
